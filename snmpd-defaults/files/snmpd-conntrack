#!/bin/sh
# Cheap conntrack metrics for the snmpd extends, backed only by O(1) sources.
#
# Why not read /proc/net/nf_conntrack here: a full read costs ~8-10 s of CPU
# on MT7621 with ~15k entries (seq_file renders every entry under lock; cost
# scales with read buffer size, see below), and net-snmp runs extend programs
# synchronously in the agent loop, so the whole agent goes unresponsive for
# the duration of the scan. Measured 2026-10-05 on LOR-Accel (RB750Gr3,
# 6.12, ~15k conntrack): wc -l 7.7 s, grep -c HW_OFFLOAD 13.6 s,
# "dd bs=131072 | grep -c" 3.6 s, /proc/sys/net/netfilter/nf_conntrack_count
# 0.00 s, wc -l /sys/kernel/debug/ppe0/bind 0.05 s. A 3-OID SNMP poll cost
# ~38 s of agent-blocking time before this script.
#
# Output contract (LibreNMS Custom OID, GAUGE): one bare integer, exit 0.

case "${1:-}" in
total)
	# Kernel entry counter, O(1). Counts unconfirmed/dying entries that the
	# nf_conntrack seq file skips, so it reads ~10% higher than the old
	# "wc -l /proc/net/nf_conntrack" did. The seq-file fallback is only for
	# kernels without the sysctl.
	if [ -r /proc/sys/net/netfilter/nf_conntrack_count ]; then
		cat /proc/sys/net/netfilter/nf_conntrack_count
	else
		wc -l < /proc/net/nf_conntrack 2>/dev/null || echo 0
	fi
	;;
hw)
	# Flows currently bound in the PPE/FOE table (MT7621 HNAT, MT7981), so
	# what the switch chip is actually forwarding. This is stricter than
	# counting [HW_OFFLOAD] flags in nf_conntrack (the flag outlives the PPE
	# slot: 395 bound vs 3050 flagged at the same instant) and 200x cheaper.
	# No PPE means no hardware offload, so 0 is the true answer.
	ppe=/sys/kernel/debug/ppe0/bind
	if [ ! -r "$ppe" ] && [ -d /sys/kernel/debug ]; then
		mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
	fi
	if [ -r "$ppe" ]; then
		wc -l < "$ppe" 2>/dev/null || echo 0
	else
		echo 0
	fi
	;;
permille)
	# PPE-bound flows per 1000 conntrack entries. Permille, not percent:
	# Custom OID has no floats.
	t=$("$0" total)
	h=$("$0" hw)
	case "$t" in ''|*[!0-9]*) t=0 ;; esac
	case "$h" in ''|*[!0-9]*) h=0 ;; esac
	echo $((h*1000/(t>0?t:1)))
	;;
*)
	echo 0
	;;
esac

exit 0