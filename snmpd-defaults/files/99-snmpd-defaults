#!/bin/sh
# LooperWrt snmpd defaults. Idempotent: runs once from /etc/uci-defaults on
# first boot, and from the package postinst on a running system.

[ -x /sbin/uci ] || exit 0

# --- agent: bind only the LooperWrt port --------------------------------
if uci -q get snmpd.@agent[0] >/dev/null 2>&1; then
	uci -q set snmpd.@agent[0].agentaddress='UDP:16161'
else
	uci -q set snmpd.agent=agent
	uci -q set snmpd.agent.agentaddress='UDP:16161'
fi

# --- access: drop the stock "public" read path, add ours ----------------
# stock sections: com2sec public/public6, group public_{v1,v2c,usm},
# access public_access. "private" stays: it is localhost-only and read-write.
for s in public public6 public_v1 public_v2c public_usm public_access; do
	uci -q delete "snmpd.$s"
done

# access_default expands to: rocommunity <CommunityName> default
uci -q delete snmpd.looperwrt_ro
uci set snmpd.looperwrt_ro=access_default
uci set snmpd.looperwrt_ro.Mode='rocommunity'
uci set snmpd.looperwrt_ro.CommunityName='publicagentxD'
uci set snmpd.looperwrt_ro.RestrictOID='no'

# --- system -------------------------------------------------------------
if uci -q get snmpd.@system[0] >/dev/null 2>&1; then
	uci -q set snmpd.@system[0].sysLocation='La Paz, BO'
	uci -q set snmpd.@system[0].sysContact='Admin'
	# unset so the initscript derives sysName from the device hostname
	uci -q delete snmpd.@system[0].sysName
fi

# --- always-available extends -------------------------------------------
uci -q delete snmpd.temperature
uci set snmpd.temperature=extend
uci set snmpd.temperature.name='temperature'
uci set snmpd.temperature.prog='/bin/cat'
uci set snmpd.temperature.args='/sys/class/thermal/thermal_zone0/temp'

# --- conntrack + PPE offload -------------------------------------------
# All three go through /usr/sbin/snmpd-conntrack and must stay backed by
# O(1) sources: a full read of /proc/net/nf_conntrack costs ~8-10 s of CPU
# on MT7621 with ~15k entries, and net-snmp runs extend programs
# synchronously in the agent loop, so the whole agent goes unresponsive for
# the scan (SNMP walks of the extend table time out and the poller retries).
# Bare integers for LibreNMS Custom OID (GAUGE).
# conntrack = kernel entry counter (includes unconfirmed/dying entries the
# seq file skips, so it reads ~10% higher than the old wc -l did).
# conntrack_hw = flows bound in the PPE/FOE table right now (MT7621 HNAT /
# MT7981), not the [HW_OFFLOAD] flag in nf_conntrack: that flag outlives the
# PPE slot and drifts high. conntrack_hw_permille = hw*1000/total (permille,
# not percent: Custom OID has no floats).
# All three are 5-minute rolling means: the snmpd-ctavg service samples the
# sources every 30 s into /tmp and snmpd-conntrack averages the window, so
# LibreNMS's 5-min polls do not see the raw counters jump around.
uci -q delete snmpd.conntrack
uci set snmpd.conntrack=extend
uci set snmpd.conntrack.name='conntrack'
uci set snmpd.conntrack.prog='/usr/sbin/snmpd-conntrack'
uci set snmpd.conntrack.args='total'

uci -q delete snmpd.conntrack_hw
uci set snmpd.conntrack_hw=extend
uci set snmpd.conntrack_hw.name='conntrack_hw'
uci set snmpd.conntrack_hw.prog='/usr/sbin/snmpd-conntrack'
uci set snmpd.conntrack_hw.args='hw'

uci -q delete snmpd.conntrack_hw_permille
uci set snmpd.conntrack_hw_permille=extend
uci set snmpd.conntrack_hw_permille.name='conntrack_hw_permille'
uci set snmpd.conntrack_hw_permille.prog='/usr/sbin/snmpd-conntrack'
uci set snmpd.conntrack_hw_permille.args='permille'

# conntrack_sw is gone: sw flow-offload entries were only visible in a full
# nf_conntrack scan. Remove the old section on upgrade.
uci -q delete snmpd.conntrack_sw

# --- DHCP live sessions -------------------------------------------------
# Live (unexpired) lease counts, not raw line counts: dnsmasq keeps
# /tmp/dhcp.leases and odhcpd keeps /tmp/odhcpd.leases after expiry, so a
# bare wc -l overcounts. dnsmasq format is "<expiry> <mac> <ip> ...";
# odhcpd format is "# <iface> <duid> <tok> <host> <expiry> ...".
# Quoting constraint: args pass through the snmpd.conf parser before
# /bin/sh, which eats backslashes and nested quotes (an awk '$1>n'
# program arrives broken and yields 0). So plain shell loops only, no
# backslashes, no nested quotes. Bare integers, always exit 0.
uci -q delete snmpd.dhcp_leases
uci set snmpd.dhcp_leases=extend
uci set snmpd.dhcp_leases.name='dhcp_leases'
uci set snmpd.dhcp_leases.prog='/bin/sh'
uci set snmpd.dhcp_leases.args='-c "n=$(date +%s);c=0;while read e r; do [ $e -gt $n ] 2>/dev/null && c=$((c+1)); done 2>/dev/null </tmp/dhcp.leases;echo $c"'

uci -q delete snmpd.dhcp6_leases
uci set snmpd.dhcp6_leases=extend
uci set snmpd.dhcp6_leases.name='dhcp6_leases'
uci set snmpd.dhcp6_leases.prog='/bin/sh'
uci set snmpd.dhcp6_leases.args='-c "n=$(date +%s);k=0;while read a b c d e x r; do [ $x -gt $n ] 2>/dev/null && k=$((k+1)); done 2>/dev/null </tmp/odhcpd.leases;echo $k"'

uci -q delete snmpd.hardware
uci set snmpd.hardware=extend
uci set snmpd.hardware.name='hardware'
uci set snmpd.hardware.prog='/bin/cat'
uci set snmpd.hardware.args='/sys/firmware/devicetree/base/model'

uci commit snmpd

# pick the change up immediately when installing onto a running system
[ -x /etc/init.d/snmpd ] && /etc/init.d/snmpd restart >/dev/null 2>&1

exit 0
