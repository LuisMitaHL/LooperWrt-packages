#!/bin/sh /etc/rc.common
# Rolling-mean sampler for the snmpd conntrack extends.
# Feeds /usr/sbin/snmpd-conntrack (snmpd-ctavg.* files in /tmp); the
# extends report the trailing 5-minute mean so LibreNMS graphs do not jump
# with the raw counters between 5-min polls.

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/snmpd-conntrack loop
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
