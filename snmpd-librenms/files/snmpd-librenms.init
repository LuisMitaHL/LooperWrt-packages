#!/bin/sh /etc/rc.common
# LibreNMS wireless extend reconciler for snmpd.

START=99
STOP=10
USE_PROCD=1

start_service() {
	local enabled

	config_load snmpd-librenms
	config_get_bool enabled general enabled 1
	[ "$enabled" -eq 1 ] || return 0

	# Nothing to reconcile without wireless: iw shows no wdevs and hostapd
	# exports no ubus object (wifi-less boards). Skip instead of starting
	# a watcher that spins on a dead `ubus subscribe hostapd`.
	if ! iw dev 2>/dev/null | grep -q 'Interface '; then
		ubus list 2>/dev/null | grep -qx 'hostapd' || {
			logger -t snmpd-librenms "no wireless, not starting" 2>/dev/null
			return 0
		}
	fi

	procd_open_instance
	procd_set_param command /usr/sbin/snmpd-librenms-sync watch
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger snmpd-librenms
}
