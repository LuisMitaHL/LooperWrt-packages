#!/bin/sh
# zz-pasankalla -- first-boot defaults for the Pasankalla feed package.
#
# Named zz-* so it runs AFTER the branch's 99_aurora-defaults on the TR3000:
# that script rewrites every existing wifi-iface into a LOR_ private AP, so
# creating the guest BSS earlier would get it clobbered. Idempotent: package
# upgrades can re-run it, and it adopts an existing "Pasankalla gratis"
# open+hidden-OWE transition pair instead of creating duplicate BSSes.
#
# It creates (only when missing):
#   * lanclientes: a dedicated guest interface on a local br-guest bridge,
#     100.102.13.37/16, in the lan firewall zone, with a DHCP server;
#     a real bridge is required so hostapd can attach the guest BSSes and
#     run ap_isolate/proxy_arp (x_snoop rejects a bridge-less interface);
#   * trm_wwan/trm_wwan6 in the wan firewall zone, for travelmate;
#   * wanusb/wanusb6 in the wan firewall zone, the lower-priority uplink a
#     USB LTE modem or USB Ethernet dongle provides (metric 200, below
#     travelmate's 100); its device is set at runtime by pasankalla;
#   * one OWE-only guest AP per built-in band, SSID "Pasankalla gratis",
#     disabled until the slider is turned on;
#   * the travelmate trm_iface/trm_radio baseline; travelmate is enabled by
#     default and only stopped while the ethernet WAN carries the uplink.
#
# No wifi reload here: this runs during boot before/around wifi start, and a
# live package install leaves the new guest BSSes disabled until the slider
# is flipped (which triggers an apply).

CONFIG=pasankalla
GUEST_NET=lanclientes
TRM_IF=trm_wwan
TRM6_IF=trm_wwan6
USB_ETH_IF=wanusb
USB_ETH6_IF=wanusb6
USB_ETH_METRIC=200

notice() {
	echo "pasankalla: $*" > /dev/kmsg 2>/dev/null
}

die() {
	notice "$*"
	exit 1
}

find_dev() {
	uci -q show network 2>/dev/null |
		sed -n "s/^network\.\([^.=]*\)\.name='$1'$/\1/p" | head -n1
}

zone_id() {
	uci -q show firewall 2>/dev/null |
		sed -n "s/^firewall\.\([^.=]*\)\.name='$1'$/\1/p" | head -n1
}

add_zone_network() {
	local z="$1" n="$2"
	[ -n "$z" ] || return 0
	case " $(uci -q get "firewall.$z.network") " in
	*" $n "*) return 0 ;;
	esac
	uci -q add_list "firewall.$z.network=$n"
	FIREWALL_CHANGED=1
}

find_dhcp_iface() {
	local s
	for s in $(uci -q show dhcp 2>/dev/null | sed -n 's/^dhcp\.\([^.=]*\)=dhcp$/\1/p'); do
		[ "$(uci -q get "dhcp.$s.interface")" = "$1" ] && { echo "$s"; return 0; }
	done
	return 1
}

antilag_section() {
	local s
	for s in wan primary; do
		[ "$(uci -q get "antilag.$s")" = antilag ] && {
			echo "$s"
			return 0
		}
	done
	uci -q show antilag 2>/dev/null |
		sed -n 's/^antilag\.\([^.=]*\)=antilag$/\1/p' | head -n1
}

wan_dev() {
	local d
	d=$(ifstatus wan 2>/dev/null | jsonfilter -e '@["l3_device"]' 2>/dev/null)
	case "$d" in
	''|null)
		d=$(uci -q get network.wan.device)
		;;
	esac
	case "$d" in
	''|null|@*) return 1 ;;
	esac
	echo "$d"
}

radio_list() {
	uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'
}

radio_band() {
	local b ch hw
	b=$(uci -q get "wireless.$1.band")
	case "$b" in
	2g|5g) echo "$b"; return 0 ;;
	esac
	ch=$(uci -q get "wireless.$1.channel")
	case "$ch" in
	''|auto) ;;
	*[!0-9]*) ;;
	*)
		if [ "$ch" -le 14 ]; then echo 2g; else echo 5g; fi
		return 0
		;;
	esac
	hw=$(uci -q get "wireless.$1.hwmode")
	case "$hw" in
	*11a*) echo 5g; return 0 ;;
	*11g*) echo 2g; return 0 ;;
	esac
	case "$1" in
	*0) echo 2g ;;
	*1) echo 5g ;;
	esac
}

[ -f /etc/config/network ] || exit 1
uci show network >/dev/null 2>&1 || die "network config is unparseable"
[ -f /etc/config/wireless ] || exit 1
uci show wireless >/dev/null 2>&1 || die "wireless config is unparseable"

GUEST_SSID=$(uci -q get "$CONFIG.settings.guest_ssid")
[ -n "$GUEST_SSID" ] || GUEST_SSID='Pasankalla gratis'
GUEST_NET=$(uci -q get "$CONFIG.settings.guest_network")
[ -n "$GUEST_NET" ] || GUEST_NET=lanclientes

NETWORK_CHANGED=0
FIREWALL_CHANGED=0
DHCP_CHANGED=0
WIRELESS_CHANGED=0
TRAVELMATE_CHANGED=0
ANTILAG_CHANGED=0
PASANKALLA_CHANGED=0
GUEST_NET_OK=0

# --- guest network: dedicated guest bridge + lanclientes -------------------
# hostapd attaches a BSS to the bridge of its "network" interface and writes
# bridge=<name>. With ap_isolate/proxy_arp, x_snoop also requires a real
# bridge; a VLAN device such as br-lan.10 is not one. Give the guest network
# its own empty bridge: this starts hostapd and keeps guest L2 traffic off
# the LAN ports.
GUEST_NET_OK=1
guest_dev=br-guest
guest_s=$(find_dev br-guest)
if [ -z "$guest_s" ]; then
	guest_s=guestdev
	uci -q set "network.$guest_s=device"
	uci -q set "network.$guest_s.name=$guest_dev"
	uci -q set "network.$guest_s.type=bridge"
	uci -q set "network.$guest_s.bridge_empty=1"
	NETWORK_CHANGED=1
elif [ "$(uci -q get "network.$guest_s.type")" != bridge ] ||
     [ "$(uci -q get "network.$guest_s.bridge_empty")" != 1 ]; then
	uci -q set "network.$guest_s.type=bridge"
	uci -q set "network.$guest_s.bridge_empty=1"
	NETWORK_CHANGED=1
fi
if [ "$(uci -q get "network.$GUEST_NET")" != interface ]; then
	uci -q set "network.$GUEST_NET=interface"
	uci -q set "network.$GUEST_NET.proto=static"
	uci -q set "network.$GUEST_NET.ipaddr=100.102.13.37"
	uci -q set "network.$GUEST_NET.netmask=255.255.0.0"
	NETWORK_CHANGED=1
fi
if [ "$(uci -q get "network.$GUEST_NET.device")" != "$guest_dev" ]; then
	uci -q set "network.$GUEST_NET.device=$guest_dev"
	NETWORK_CHANGED=1
fi

# --- travelmate uplink interface + firewall --------------------------------
# trm_wwan is probed for its default route by route/lookup, so pasankalla
# unplugs the travelmate STA from this network while the WAN owns the uplink
# (see tm_setif in /usr/sbin/pasankalla); the interface stays configured.
if ! uci -q get "network.$TRM_IF" >/dev/null 2>&1; then
	uci -q set "network.$TRM_IF=interface"
	uci -q set "network.$TRM_IF.proto=dhcp"
	uci -q set "network.$TRM_IF.metric=100"
	NETWORK_CHANGED=1
fi
# Never give trm_wwan a device of its own. With no device netifd builds
# br-trm_wwan out of the STA that travelmate plugs into the network, and the
# wan zone binds to that bridge when it appears. An early build pinned it to
# br-lan "so the wan zone owns a device"; that runs the trm_wwan DHCP client
# on the LAN bridge and pulls the travelmate STA into the LAN instead.
if [ -n "$(uci -q get "network.$TRM_IF.device")" ]; then
	uci -q delete "network.$TRM_IF.device"
	NETWORK_CHANGED=1
fi
if ! uci -q get "network.$TRM6_IF" >/dev/null 2>&1; then
	uci -q set "network.$TRM6_IF=interface"
	uci -q set "network.$TRM6_IF.proto=dhcpv6"
	uci -q set "network.$TRM6_IF.device=@$TRM_IF"
	uci -q set "network.$TRM6_IF.reqaddress=try"
	uci -q set "network.$TRM6_IF.reqprefix=no"
	NETWORK_CHANGED=1
fi

# The USB uplink is a plain DHCP client on whatever netdev the daemon finds
# (an LTE modem in NCM/ECM mode or a USB Ethernet dongle). No device is set
# here: netifd keeps the interface down until pasankalla points it at a
# dongle that is really plugged in.
if ! uci -q get "network.$USB_ETH_IF" >/dev/null 2>&1; then
	uci -q set "network.$USB_ETH_IF=interface"
	uci -q set "network.$USB_ETH_IF.proto=dhcp"
	uci -q set "network.$USB_ETH_IF.metric=$USB_ETH_METRIC"
	NETWORK_CHANGED=1
fi
if ! uci -q get "network.$USB_ETH6_IF" >/dev/null 2>&1; then
	uci -q set "network.$USB_ETH6_IF=interface"
	uci -q set "network.$USB_ETH6_IF.proto=dhcpv6"
	uci -q set "network.$USB_ETH6_IF.device=@$USB_ETH_IF"
	uci -q set "network.$USB_ETH6_IF.reqaddress=try"
	uci -q set "network.$USB_ETH6_IF.reqprefix=no"
	NETWORK_CHANGED=1
fi

if [ -f /etc/config/firewall ]; then
	wan_zone=$(zone_id wan)
	[ -n "$wan_zone" ] || wan_zone=$(uci -q show firewall | sed -n 's/^firewall\.\([^.=]*\)\.masq=.1.$/\1/p' | head -n1)
	add_zone_network "$wan_zone" "$TRM_IF"
	add_zone_network "$wan_zone" "$TRM6_IF"
	add_zone_network "$wan_zone" "$USB_ETH_IF"
	add_zone_network "$wan_zone" "$USB_ETH6_IF"
	if [ "$GUEST_NET_OK" = 1 ]; then
		lan_zone=$(zone_id lan)
		add_zone_network "$lan_zone" "$GUEST_NET"
	fi
fi

# --- guest DHCP ------------------------------------------------------------
if [ "$GUEST_NET_OK" = 1 ] && [ -f /etc/config/dhcp ]; then
	if ! find_dhcp_iface "$GUEST_NET" >/dev/null; then
		uci -q set "dhcp.$GUEST_NET=dhcp"
		uci -q set "dhcp.$GUEST_NET.interface=$GUEST_NET"
		uci -q set "dhcp.$GUEST_NET.start=3585"
		uci -q set "dhcp.$GUEST_NET.limit=60000"
		uci -q set "dhcp.$GUEST_NET.leasetime=2m"
		uci -q set "dhcp.$GUEST_NET.force=1"
		DHCP_CHANGED=1
	fi
fi

# --- guest APs: adopt the existing pair, otherwise create OWE-only ---------
adopted=""
have2g=0
have5g=0
for s in $(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
	case "$s" in
	@*) continue ;;
	esac
	[ "$(uci -q get "wireless.$s.mode")" = ap ] || continue
	ssid=$(uci -q get "wireless.$s.ssid")
	case "$ssid" in
	"$GUEST_SSID"|"$GUEST_SSID WPA3") ;;
	*) continue ;;
	esac
	[ "$(uci -q get "wireless.$s.network")" = "$GUEST_NET" ] || continue
	adopted="$adopted $s"
	dev=$(uci -q get "wireless.$s.device")
	band=$(radio_band "$dev")
	[ "$band" = 2g ] && have2g=1
	[ "$band" = 5g ] && have5g=1
done

create_guest() {
	local n="$1" r="$2"
	if uci -q get "wireless.$n" >/dev/null 2>&1; then
		notice "wireless.$n exists but is not a Pasankalla guest; leaving it alone"
		return 1
	fi
	uci -q set "wireless.$n=wifi-iface"
	uci -q set "wireless.$n.device=$r"
	uci -q set "wireless.$n.mode=ap"
	uci -q set "wireless.$n.ssid=$GUEST_SSID"
	uci -q set "wireless.$n.encryption=owe"
	uci -q set "wireless.$n.network=$GUEST_NET"
	uci -q set "wireless.$n.disabled=1"
	uci -q set "wireless.$n.ieee80211k=1"
	uci -q set "wireless.$n.wnm_sleep_mode=1"
	uci -q set "wireless.$n.bss_transition=1"
	uci -q set "wireless.$n.proxy_arp=1"
	uci -q set "wireless.$n.dtim_period=3"
	uci -q set "wireless.$n.max_inactivity=60"
	adopted="$adopted $n"
	WIRELESS_CHANGED=1
	return 0
}

if [ "$GUEST_NET_OK" = 1 ]; then
	for r in $(radio_list); do
		case "$r" in
		@*) continue ;;
		esac
		path=$(uci -q get "wireless.$r.path")
		case "$path" in
		*usb*) continue ;;
		esac
		band=$(radio_band "$r")
		case "$band" in
		2g)
			[ "$have2g" = 1 ] || create_guest pasankalla2 "$r"
			;;
		5g)
			[ "$have5g" = 1 ] || create_guest pasankalla5 "$r"
			;;
		esac
	done

	if [ -n "$adopted" ]; then
		for s in $adopted; do
			case " $(uci -q get "$CONFIG.settings.guest_sections") " in
			*" $s "*) ;;
			*)
				uci -q add_list "$CONFIG.settings.guest_sections=$s"
				PASANKALLA_CHANGED=1
				;;
			esac
		done
	fi
fi

# --- travelmate baseline ---------------------------------------------------
if [ -f /etc/config/travelmate ]; then
	if ! uci -q get travelmate.global >/dev/null 2>&1; then
		uci -q set travelmate.global=travelmate
		TRAVELMATE_CHANGED=1
	fi
	[ "$(uci -q get travelmate.global.trm_iface)" = "$TRM_IF" ] || {
		uci -q set "travelmate.global.trm_iface=$TRM_IF"
		TRAVELMATE_CHANGED=1
	}
	if [ -z "$(uci -q get travelmate.global.trm_radio)" ]; then
		r=$(for x in $(radio_list); do
			case "$(uci -q get "wireless.$x.path")" in *usb*) continue ;; esac
			[ "$(radio_band "$x")" = 5g ] && { echo "$x"; break; }
		done)
		[ -n "$r" ] && { uci -q set "travelmate.global.trm_radio=$r"; TRAVELMATE_CHANGED=1; }
	fi
	for s in $(uci -q show wireless | sed -n 's/^wireless\.\(trm_uplink[0-9]*\)=wifi-iface$/\1/p'); do
		[ "$(uci -q get "wireless.$s.network")" = "$TRM_IF" ] || {
			uci -q set "wireless.$s.network=$TRM_IF"
			WIRELESS_CHANGED=1
		}
	done
	# Enabled by default (it is a travel router): travelmate starts at boot
	# and pasankalla only stops it and unplugs its STA from network.trm_wwan
	# while the ethernet WAN carries the uplink. trm_enabled must be 1 too:
	# travelmate-service exits on its own with "travelmate is disabled"
	# otherwise, no matter what the rc.d symlink says.
	[ "$(uci -q get travelmate.global.trm_enabled)" = 1 ] || {
		uci -q set travelmate.global.trm_enabled=1
		TRAVELMATE_CHANGED=1
	}
	/etc/init.d/travelmate enable >/dev/null 2>&1
fi

# --- one-shot service defaults --------------------------------------------
# Pasankalla is a travel router: enable the adaptive shaper on the ethernet
# WAN and keep tailscale (plus its route watchdog) out of the boot path. The
# marker keeps a later package upgrade from overriding an operator choice.
if [ "$(uci -q get "$CONFIG.settings.defaults_version")" != 1 ]; then
	if [ -f /etc/config/antilag ]; then
		al=$(antilag_section)
		if [ -n "$al" ]; then
			dev=$(wan_dev)
			if [ -n "$dev" ]; then
				[ "$(uci -q get "antilag.$al.ul_if")" = "$dev" ] || {
					uci -q set "antilag.$al.ul_if=$dev"
					uci -q set "antilag.$al.dl_if=ifb-$dev"
					ANTILAG_CHANGED=1
				}
			fi
			[ "$(uci -q get "antilag.$al.enabled")" = 1 ] || {
				uci -q set "antilag.$al.enabled=1"
				ANTILAG_CHANGED=1
			}
			/etc/init.d/antilag enable >/dev/null 2>&1
		fi
	fi
	if [ -x /etc/init.d/tailscale ]; then
		/etc/init.d/tailscale stop >/dev/null 2>&1
		/etc/init.d/tailscale disable >/dev/null 2>&1
	fi
	if [ -x /etc/init.d/tswatchdog ]; then
		/etc/init.d/tswatchdog stop >/dev/null 2>&1
		/etc/init.d/tswatchdog disable >/dev/null 2>&1
	fi
	uci -q set "$CONFIG.settings.defaults_version=1"
	PASANKALLA_CHANGED=1
fi

# --- commit ----------------------------------------------------------------
[ "$NETWORK_CHANGED" = 1 ] && { uci -q commit network || die "cannot commit network"; }
[ "$FIREWALL_CHANGED" = 1 ] && { uci -q commit firewall || die "cannot commit firewall"; }
[ "$DHCP_CHANGED" = 1 ] && { uci -q commit dhcp || die "cannot commit dhcp"; }
[ "$WIRELESS_CHANGED" = 1 ] && { uci -q commit wireless || die "cannot commit wireless"; }
[ "$TRAVELMATE_CHANGED" = 1 ] && { uci -q commit travelmate || die "cannot commit travelmate"; }
[ "$ANTILAG_CHANGED" = 1 ] && { uci -q commit antilag || die "cannot commit antilag"; }
[ "$PASANKALLA_CHANGED" = 1 ] && { uci -q commit "$CONFIG" || die "cannot commit $CONFIG"; }

[ -n "$adopted" ] || adopted=none
notice "configured guest=$GUEST_NET ssid=$GUEST_SSID sections=$adopted"
exit 0
