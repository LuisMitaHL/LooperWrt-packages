#!/bin/sh /etc/rc.common
# Pasankalla uplink/LED state machine. START=98 is after gpio_switch (S94)
# and led (S96), and after network/wifi/travelmate, so the first apply sees
# the real boot state. The daemon only sleeps between 30 s safety-net polls;
# all blinking is done by the kernel LED timer trigger.

USE_PROCD=1
START=98
STOP=10

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/pasankalla daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	/usr/sbin/pasankalla apply
}

service_triggers() {
	procd_add_reload_trigger pasankalla
}
