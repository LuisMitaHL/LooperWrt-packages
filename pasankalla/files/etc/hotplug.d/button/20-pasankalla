#!/bin/sh
# Case slider (gpio-button-hotplug maps the EV_SW "mode" key to BTN_0).
# The initial state is reported at module load, so this also seeds the
# state at boot before the init script runs.

[ "$BUTTON" = "BTN_0" ] || exit 0
case "$ACTION" in
	pressed|released) ;;
	*) exit 0 ;;
esac

mkdir -p /tmp/pasankalla
if [ "$ACTION" = "pressed" ]; then
	state=1
else
	state=0
fi
echo "$state" > /tmp/pasankalla/slider
logger -t pasankalla "button BTN_0 $ACTION slider=$state" 2>/dev/null

# Do not block the hotplug caller: applying a slider change may reload wifi.
/usr/sbin/pasankalla apply >/dev/null 2>&1 &
