#!/bin/sh
# Pasankalla uplink/LED state machine and guest-AP manager.
#
# States (white:status / red:power):
#   wan     WAN has an address              white solid     red off
#   wifi    travelmate on built-in 5 GHz    white 1s blink  red off
#   usb     travelmate on a USB WiFi radio  white 0.25s     red off
#   offline no internet after the grace     white off       red 1s blink
#   disabled master switch off              both off
#
# The guest AP follows the slider (BTN_0): on = enabled. The 5 GHz guest BSS
# is additionally disabled while travelmate uses that same radio. Travelmate
# uplinks are moved between the built-in 5 GHz radio and a hot-plugged USB
# radio; wan always wins: travelmate is stopped and its STA is unplugged from
# network.trm_wwan so it cannot outbid the ethernet WAN. Travelmate stays
# enabled and is started again as soon as the WAN lease is gone; a runtime
# ledger ($STATE_DIR/tm) remembers which side owns the uplink so the
# travelmate init being disabled never makes the next poll re-enable it.
#
# Event sources: /etc/hotplug.d/button, /etc/hotplug.d/iface,
# /etc/hotplug.d/ieee80211, plus a poll (poll_interval, 3 s by default) from
# the procd daemon. All
# applies are serialized with flock. LED blinking is done by the kernel LED
# timer trigger, not by this script.

CONFIG=pasankalla
STATE_DIR=/tmp/pasankalla
SLIDER_FILE="$STATE_DIR/slider"
OFFLINE_FILE="$STATE_DIR/offline_since"
WAN_LINK_FILE="$STATE_DIR/wan_link_down"
# Set while the WAN interface was torn down because its port died; the next
# apply brings it back when the port links again.
WAN_TORN_FILE="$STATE_DIR/wan_torn"
WAN_PROBE_FILE="$STATE_DIR/wan_probe"
SIG_FILE="$STATE_DIR/sig"
DETECT_FILE="$STATE_DIR/detect"
TM_FILE="$STATE_DIR/tm"
DAEMON_PID="$STATE_DIR/daemon.pid"
TM_RETRY_FILE="$STATE_DIR/tm_retry"
PENDING_FILE="$STATE_DIR/pending"
RG_LOCK="$STATE_DIR/run.lock"
# Our own argv[0] + action ("/usr/sbin/pasankalla apply", "/usr/sbin/pasankalla
# daemon"), matched against /proc/<pid>/cmdline. The daemon's lock owner is its
# own pid, so the match cannot be a fixed string.
SCRIPT_ARGV="$0 $1 "

WAN_IF=wan
WAN6_IF=wan6
TRM_IF=trm_wwan
TRM6_IF=trm_wwan6
TRM_IFACE=trm_wwan

log() {
	logger -t pasankalla "$*" 2>/dev/null
}

is_num() {
	case "$1" in
	''|*[!0-9]*) return 1 ;;
	*) return 0 ;;
	esac
}

# ubus reply with a wall-clock deadline. A plain ifstatus blocks for as long
# as netifd takes, and netifd blocks on the interface's own setup scripts:
# a DHCP-less wan (no cable) renews wan and wan6 forever on the TR1200 and
# an unbounded ifstatus hung an apply for over ten minutes. busybox has no
# timeout(1), so the caller polls for the reply file.
ubus_status() {
	ubus -t 5 call "network.interface.$1" status
}

ifstatus() {
	local f i n
	f="/tmp/pasankalla.status.$1.$$"
	rm -f "$f"
	( ubus_status "$1" > "$f" 2>/dev/null ) &
	ubus_pid=$!
	# Poll the REPLY FILE, not the child: ubus writes its JSON a few
	# milliseconds before it exits, so a loop that kills on the first
	# "child still alive" check loses every reply and makes wan_ok() see an
	# interface with no address. This busybox has no fractional sleep and no
	# usleep, so the first ~200 rounds are a bare stat spin (microseconds of
	# CPU, a normal reply lands there) and only a reply that still has not
	# arrived costs a whole second each round, with IFSTATUS_TIMEOUT as the
	# ceiling. ubus -t 5 is the real bound; this just keeps a wedged ubusd
	# from holding the apply lock.
	i=0
	n=0
	while :; do
		if [ -s "$f" ]; then
			break
		fi
		if ! kill -0 "$ubus_pid" 2>/dev/null; then
			break
		fi
		n=$((n + 1))
		if [ "$n" -ge 200 ]; then
			n=0
			i=$((i + 1))
			if [ "$i" -gt "$IFSTATUS_TIMEOUT" ]; then
				break
			fi
			sleep 1
		fi
	done
	# -TERM is a no-op when it already answered and exited. Never wait
	# unbounded: a ubus stuck behind a wedged netifd ignores the signal and
	# an ordinary 'pasankalla status' then sits there for minutes. Give it
	# two seconds, kill whatever is left and leave the zombie to init.
	kill -TERM "$ubus_pid" 2>/dev/null
	i=0
	while kill -0 "$ubus_pid" 2>/dev/null && [ "$i" -lt 2 ]; do
		i=$((i + 1))
		sleep 1
	done
	kill -KILL "$ubus_pid" 2>/dev/null
	cat "$f" 2>/dev/null
	rm -f "$f"
	return 0
}

# Serialize the applies: the daemon poll and every hotplug/menu action fork
# this script, and each apply rewrites UCI configs (uci replaces the file),
# so two at once can drop one of the writes. A plain mkdir is atomic, needs
# no coreutils and leaves nothing behind once the holder releases it; a
# holder that died is recognised by its pid being gone or by the lock being
# older than RG_LOCK_MAX seconds.
RG_LOCK_MAX=120
# ubus answers within -t on its own; the poll only guards against a child
# that never returns (ubusd restarting, a stuck netifd). Five seconds is way
# above the real reply time (milliseconds) and keeps a dead ubusd from
# stretching one apply into minutes - an apply with the lock taken is what
# every other hook waits behind.
IFSTATUS_TIMEOUT=5


is_pasankalla_pid() {
	local c
	c=$(tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null)
	# procd runs the script as "/bin/sh /usr/sbin/pasankalla daemon ",
	# so the argv we match on is a substring of the cmdline, never the
	# whole of it.
	case "$c" in
	*"$SCRIPT_ARGV"*) return 0 ;;
	esac
	return 1
}

run_lock() {
	local now age pid
	now=$(date +%s)
	if mkdir "$RG_LOCK" 2>/dev/null; then
		echo "$$ $now" > "$RG_LOCK/owner" 2>/dev/null
		return 0
	fi
	read -r pid age < "$RG_LOCK/owner" 2>/dev/null
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && is_pasankalla_pid "$pid"; then
		return 1
	fi
	if is_num "$now" && is_num "$age" && [ $((now - age)) -lt "$RG_LOCK_MAX" ] &&
	   [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		return 1
	fi
	# Holder is gone (killed, or the script was replaced under it).
	rm -rf "$RG_LOCK" 2>/dev/null
	if mkdir "$RG_LOCK" 2>/dev/null; then
		echo "$$ $now" > "$RG_LOCK/owner" 2>/dev/null
		return 0
	fi
	return 1
}

run_unlock() {
	rm -rf "$RG_LOCK" 2>/dev/null
}
cfg() {
	local v
	v=$(uci -q get "$CONFIG.settings.$1")
	if [ -n "$v" ]; then
		echo "$v"
	else
		echo "$2"
	fi
}

load_cfg() {
	ENABLED=$(cfg enabled 1)
	GUEST_SSID=$(cfg guest_ssid 'Pasankalla gratis')
	GUEST_NET=$(cfg guest_network 'lanclientes')
	GUEST_5G_FOLLOW=$(cfg guest_5g_follow_uplink 1)
	SLIDER_INVERT=$(cfg slider_invert 0)
	WAN_GRACE=${WAN_GRACE:=$(cfg wan_grace 20)}
	OFFLINE_AFTER=$(cfg offline_after 60)
	POLL_INTERVAL=$(cfg poll_interval 10)
	WAN_DOWN_AFTER=$(cfg wan_down_after 30)
	WAN_PROBE_INTERVAL=$(cfg wan_probe_interval 20)
	TM_RETRY=$(cfg travelmate_retry 120)
	LED_WHITE=$(cfg led_white 'white:status')
	LED_RED=$(cfg led_red 'red:power')

	is_num "$WAN_GRACE" || WAN_GRACE=20
	is_num "$OFFLINE_AFTER" || OFFLINE_AFTER=60
	is_num "$POLL_INTERVAL" || POLL_INTERVAL=3
	if ! [ "$OFFLINE_AFTER" -ge 0 ] 2>/dev/null; then
		OFFLINE_AFTER=60
	fi
	if ! [ "$POLL_INTERVAL" -ge 3 ] 2>/dev/null; then
		POLL_INTERVAL=3
	fi
	if ! is_num "$WAN_DOWN_AFTER"; then
		WAN_DOWN_AFTER=30
	fi
	if [ "$WAN_DOWN_AFTER" -lt 0 ] 2>/dev/null; then
		WAN_DOWN_AFTER=30
	fi
	if ! is_num "$WAN_PROBE_INTERVAL"; then
		WAN_PROBE_INTERVAL=20
	fi
	if [ "$WAN_PROBE_INTERVAL" -lt 5 ] 2>/dev/null; then
		WAN_PROBE_INTERVAL=5
	fi
	if ! is_num "$TM_RETRY"; then
		TM_RETRY=120
	fi
	if ! is_num "$IFSTATUS_TIMEOUT" || [ "$IFSTATUS_TIMEOUT" -lt 1 ] 2>/dev/null; then
		IFSTATUS_TIMEOUT=5
	fi
}

iface_v4() {
	local addr
	addr=$(ifstatus "$1" 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
	case "$addr" in
	''|null|0.0.0.0|169.254.*) return 1 ;;
	esac
	return 0
}

iface_v6() {
	local addr
	for addr in $(ifstatus "$1" 2>/dev/null | jsonfilter -e '@["ipv6-address"][*].address' 2>/dev/null); do
		case "$addr" in
		null|fe80:*|'') continue ;;
		esac
		return 0
	done
	return 1
}

# Sysfs carrier of a kernel netdev: fail = no carrier, 1 = up or unknown.
dev_carrier_up() {
	local c
	[ -n "$1" ] || return 0
	if [ -r "/sys/class/net/$1/carrier" ]; then
		read -r c < "/sys/class/net/$1/carrier" 2>/dev/null
		if [ "$c" = 0 ]; then
			return 1
		fi
	elif [ -r "/sys/class/net/$1/operstate" ]; then
		read -r c < "/sys/class/net/$1/operstate" 2>/dev/null
		if [ "$c" = down ]; then
			return 1
		fi
	fi
	return 0
}

# Port of the physical switch that carries a VLAN netdev like eth0.2, taken
# from network.switch_vlan.<name>.ports (port listed as "1t" or "1").
switch_port_of() {
	local vd v p vlan
	vlan=$1
	for vd in $(uci -q show network | sed -n 's/^network\.\([^.=]*\)=switch_vlan$/\1/p'); do
		[ "$(uci -q get "network.$vd.vlan")" = "$vlan" ] || continue
		for v in $(uci -q get "network.$vd.ports"); do
			case "$v" in
			*[!0-9t]*) continue ;;
			esac
			v=${v%t}
			# Skip the CPU port (an 8, 6t, ... port also listed on the
			# other VLANs); it is the one that stays up after unplug.
			for p in $(uci -q get "network.$(uci -q get "network.$vd.device").ports"); do
				case " $p " in
				*" ${v}t "*) continue 2 ;;
				esac
			done
			is_num "$v" && { echo "$v"; return 0; }
		done
	done
	return 1
}

# Link of one swconfig switch port: 0 = up, 1 = down, 2 = unknown.
swconfig_port_up() {
	local sw=$1 port=$2 rest
	# The line looks like "link: port:1 link:down" or
	# "link: port:0 link:up speed:100baseT". sed prints the first matching
	# line and quits, so this costs one process instead of an awk
	# interpreter on a 580 MHz CPU.
	rest=$(swconfig dev "$sw" show 2>/dev/null |
		sed -n "/link: port:$port /{s/.* link:\([a-z][a-z]*\).*/link:\1/p;q;}")
	case "$rest" in
	link:up) return 0 ;;
	link:down) return 1 ;;
	esac
	return 2
}

# Is the link of the device that carries the WAN up?
wan_link_up() {
	local dev=$1 vlan port sw
	case "$dev" in
	'') dev_carrier_up ""; return ;;
	*.*) vlan=${dev##*.} ;;
	*) dev_carrier_up "$dev"; return ;;
	esac
	port=$(switch_port_of "$vlan") || { dev_carrier_up "$dev"; return; }
	sw=$(uci -q get network.@switch[0].name)
	[ -n "$sw" ] || sw=switch0
	swconfig_port_up "$sw" "$port"
	case $? in
	0|2) return 0 ;;
	*) return 1 ;;
	esac
}


# The port probe is the expensive part of the WAN check: `swconfig dev
# switch0 show` costs ~0.4 s on a 580 MHz CPU, every 10 s poll. The debounce
# below is timestamp based, so a cached verdict for wan_probe_interval
# seconds (default 20) decides exactly the same thing for half the cost.
wan_link_probe() {
	local dev=$1 now last verdict
	now=$(date +%s)
	last=$(sed -n '1p' "$WAN_PROBE_FILE" 2>/dev/null)
	verdict=$(sed -n '2p' "$WAN_PROBE_FILE" 2>/dev/null)
	if is_num "$last" && [ $((now - last)) -lt "$WAN_PROBE_INTERVAL" ]; then
		if [ "$verdict" = up ]; then
			return 0
		fi
		return 1
	fi
	if wan_link_up "$dev"; then
		verdict=up
	else
		verdict=down
	fi
	if [ -d "$STATE_DIR" ]; then
		printf '%s\n%s\n' "$now" "$verdict" > "$WAN_PROBE_FILE" 2>/dev/null
	fi
	if [ "$verdict" = up ]; then
		return 0
	fi
	return 1
}

# Netdev that carries the WAN (the configured device, else the l3 device).
wan_dev() {
	local dev
	dev=$(uci -q get "network.$WAN_IF.device")
	case "$dev" in ''|@*) dev=$(iface_l3dev "$WAN_IF") ;; esac
	echo "$dev"
}

# True when the port under the WAN lost its link and stayed down for
# wan_down_after seconds (debounces cable and port renegotiation). A WAN
# that is leased but has no link is useless anyway, so the lease alone is
# not enough on swconfig hardware.
wan_link_down() {
	local dev now since
	[ "$WAN_DOWN_AFTER" -gt 0 ] 2>/dev/null || return 1
	dev=$(wan_dev)
	if wan_link_probe "$dev"; then
		# Only prune inside an existing state dir: rm -f on a missing
		# path returns non-zero, and a failing command here would be
		# this function's status.
		if [ -d "$STATE_DIR" ]; then
			rm -f "$WAN_LINK_FILE" "$WAN_LINK_FILE.done" "$WAN_LINK_FILE.lease"
		fi
		return 1
	fi
	now=$(date +%s)
	since=$(cat "$WAN_LINK_FILE" 2>/dev/null)
	if ! is_num "$since"; then
		echo "$now" > "$WAN_LINK_FILE" 2>/dev/null
		# do_execve failures are reported one call late in this shell
		# (ash strips \$- only on the next exec); make sure returning
		# here can never leave a failing exec as the last status.
		log "wan link down detected on ${dev:-none}"
		return 1
	fi
	[ $((now - since)) -ge "$WAN_DOWN_AFTER" ] || return 1
	# A dead swconfig port keeps its stale lease, and its netdev counters
	# only move when netifd retries the DHCP renew on eth0.2 itself. Two
	# applies after the debounce are the evidence that it is really gone.
	if [ "$(cat "$WAN_LINK_FILE.lease" 2>/dev/null)" != "$since" ]; then
		echo "$since" > "$WAN_LINK_FILE.lease" 2>/dev/null
		log "wan port down on ${dev:-none}, waiting for the lease"
		return 1
	fi
	# From here the link has been down for the whole debounce: the WAN is
	# not usable, whatever lease netifd still reports. The announce is last
	# and returns explicitly: an unmatched [ ] test (or its negation) would
	# otherwise decide this function's status.
	if [ "$(cat "$WAN_LINK_FILE.done" 2>/dev/null)" != "$since" ]; then
		log "wan link down on ${dev:-none} for $((now - since))s"
		echo "$since" > "$WAN_LINK_FILE.done" 2>/dev/null
	fi
	return 0
}

# The WAN has no usable uplink: the switch port lost its link (swconfig),
# netifd says down (DSA) or there is no lease. The link comes first: after
# a swconfig unplug netifd keeps the stale lease and up=true for minutes.
wan_ok() {
	local up
	# The physical link comes first, always. A pulled swconfig cable keeps
	# the stale lease and up=true for minutes, and any early "leased, so we
	# are up" return here also erased the debounce timer that is the only
	# thing noticing it - which is why an unplugged WAN stayed "up" and
	# logged "wan link down detected" on every poll. The probe caches its
	# verdict, so a healthy link costs a timestamp read.
	if wan_link_down; then
		return 1
	fi
	up=$(ifstatus "$WAN_IF" 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null)
	if [ "$up" = false ]; then
		return 1
	fi
	if iface_v4 "$WAN_IF" || iface_v6 "$WAN6_IF"; then
		return 0
	fi
	return 1
}

wan_iface_up() {
	local up
	up=$(ifstatus "$WAN_IF" 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null)
	if [ "$up" = true ]; then
		return 0
	fi
	return 1
}

trm_ok() {
	iface_v4 "$TRM_IF" || iface_v6 "$TRM6_IF"
}

# Kernel netdev backing an interface. antilag shapes netdevs, not netifd
# interface names: "wan" is not a device and tc fails with
# "Cannot find device "wan"".
iface_l3dev() {
	local d
	d=$(ifstatus "$1" 2>/dev/null | jsonfilter -e '@["l3_device"]' 2>/dev/null)
	case "$d" in
	''|null)
		# Fallback: the configured device has to exist as a kernel
		# netdev, otherwise antilag would be pointed at nothing. An
		# interface that is down reports no l3_device at all, so this
		# is what points antilag at eth0.2 before the first lease.
		d=$(uci -q get "network.$1.device")
		# Only a plain netdev name: @device references and empty
		# values are not something antilag can attach to.
		case "$d" in
		''|null|@*) return 1 ;;
		esac
		[ -e "/sys/class/net/$d" ] || return 1
		;;
	esac
	echo "$d"
}

radio_list() {
	uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'
}

usb_phy_paths() {
	local p t
	for p in /sys/class/ieee80211/phy*; do
		[ -e "$p" ] || continue
		t=$(readlink -f "$p/device" 2>/dev/null) || continue
		case "$t" in
		*usb*) echo "${t#/sys/devices/}" ;;
		esac
	done
}

find_usb_radio() {
	local r rp up
	for r in $(radio_list); do
		rp=$(uci -q get "wireless.$r.path")
		case "$rp" in
		*usb*) ;;
		*) continue ;;
		esac
		for up in $USB_PATHS; do
			case "$rp" in
			"$up"|"$up"+*) echo "$r"; return 0 ;;
			esac
		done
	done
	# Fallback: a USB radio section exists but its path did not match the
	# current phy (e.g. an older section for another USB port). Prefer the
	# first one; wifi-detect will have added a matching one above when it
	# could.
	for r in $(radio_list); do
		rp=$(uci -q get "wireless.$r.path")
		case "$rp" in
		*usb*) echo "$r"; return 0 ;;
		esac
	done
	return 1
}

radio_band() {
	local b ch hw
	b=$(uci -q get "wireless.$1.band")
	case "$b" in
	2g|5g) echo "$b"; return 0 ;;
	esac
	ch=$(uci -q get "wireless.$1.channel")
	case "$ch" in
	''|auto) ;;
	*[!0-9]*) ;;
	*)
		if [ "$ch" -le 14 ]; then echo 2g; else echo 5g; fi
		return 0
		;;
	esac
	hw=$(uci -q get "wireless.$1.hwmode")
	case "$hw" in
	*11a*) echo 5g; return 0 ;;
	*11g*) echo 2g; return 0 ;;
	esac
	case "$1" in
	*0) echo 2g ;;
	*1) echo 5g ;;
	esac
}

find_builtin_5g() {
	local r rp
	for r in $(radio_list); do
		rp=$(uci -q get "wireless.$r.path")
		case "$rp" in
		*usb*) continue ;;
		esac
		if [ "$(radio_band "$r")" = 5g ]; then
			echo "$r"
			return 0
		fi
	done
	return 1
}

set_radio_disabled() {
	[ -n "$1" ] || return 0
	if [ "$(uci -q get "wireless.$1.disabled")" = "$2" ]; then
		return 0
	fi
	uci -q set "wireless.$1.disabled=$2"
	WIRELESS_CHANGED=1
}

set_trm_radio() {
	local r="$1" s
	[ -n "$r" ] || return 0
	[ -f /etc/config/travelmate ] || return 0

	if ! uci -q get travelmate.global >/dev/null 2>&1; then
		uci -q set travelmate.global=travelmate
		TRAVELMATE_CHANGED=1
	fi
	[ "$(uci -q get travelmate.global.trm_iface)" = "$TRM_IFACE" ] || {
		uci -q set "travelmate.global.trm_iface=$TRM_IFACE"
		TRAVELMATE_CHANGED=1
	}
	[ "$(uci -q get travelmate.global.trm_radio)" = "$r" ] || {
		uci -q set "travelmate.global.trm_radio=$r"
		TRAVELMATE_CHANGED=1
	}

	for s in $(uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\(trm_uplink[0-9]*\)=wifi-iface$/\1/p'); do
		[ "$(uci -q get "wireless.$s.device")" = "$r" ] || {
			uci -q set "wireless.$s.device=$r"
			WIRELESS_CHANGED=1
		}
		[ "$(uci -q get "wireless.$s.network")" = "$TRM_IFACE" ] || {
			uci -q set "wireless.$s.network=$TRM_IFACE"
			WIRELESS_CHANGED=1
		}
	done

	for s in $(uci -q show travelmate 2>/dev/null | sed -n 's/^travelmate\.\([^.=]*\)=uplink$/\1/p'); do
		[ "$(uci -q get "travelmate.$s.device")" = "$r" ] || {
			uci -q set "travelmate.$s.device=$r"
			TRAVELMATE_CHANGED=1
		}
	done
}

guest_sections() {
	local list s ssid net
	list=$(uci -q get "$CONFIG.settings.guest_sections")
	if [ -n "$list" ]; then
		echo "$list"
		return 0
	fi
	for s in $(uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
		case "$s" in
		@*) continue ;;
		esac
		[ "$(uci -q get "wireless.$s.mode")" = ap ] || continue
		ssid=$(uci -q get "wireless.$s.ssid")
		net=$(uci -q get "wireless.$s.network")
		case "$ssid" in
		"$GUEST_SSID"|"$GUEST_SSID WPA3") ;;
		*) continue ;;
		esac
		[ "$net" = "$GUEST_NET" ] || continue
		echo "$s"
	done
}

# Private APs on the radio travelmate is using must be down while it scans
# (the original scripts disabled wifilan5 on the built-in 5 GHz radio). The
# original "disabled" value is stored on the same wifi-iface section, so the
# suspend/resume transition is one atomic wireless commit and survives a
# reboot with travelmate still active.
#
# fw4 compiles the WAN zone iifname set from the state of its member
# packages: an interface that is down (trm_wwan right after boot, and again
# every time travelmate flaps it) shows up as its device, and a device-less
# one drops out entirely - forwarded travelmate traffic then hits the FORWARD
# policy (drop) with error_missing_interface, the silent "no internet" after
# a WAN drop. The iface hotplug covers up/down; this reload keeps the zone in
# step when the interface list itself changes, once per change, not per poll.
FW_SIG_FILE="$STATE_DIR/fw_zone"
WAN_ZONE_SIG=""

fw_zone_sig() {
	for z in $(uci -q show firewall 2>/dev/null | sed -n 's/^firewall\.\([^.=]*\)=zone$/\1/p'); do
		case " $(uci -q get "firewall.$z.network") " in
		*" $WAN_IF "*|*" $WAN6_IF "*|*" $TRM_IF "*|*" $TRM6_IF "*)
			echo "$z $(uci -q get "firewall.$z.network")"
			;;
		esac
	done
}

sync_wan_zone() {
	local sig seen
	sig=$(fw_zone_sig)
	[ -n "$sig" ] || return 0
	seen=$(cat "$FW_SIG_FILE" 2>/dev/null)
	if [ "$seen" = "$sig" ]; then
		return 0
	fi
	echo "$sig" > "$FW_SIG_FILE" 2>/dev/null
	ubus -t 5 call network reload >/dev/null 2>&1
	/etc/init.d/firewall reload >/dev/null 2>&1
	log "wan zone reloaded: $sig"
}

suspend_aps() {
	local r="$1" s cur
	[ -n "$r" ] || return 0
	for s in $(uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
		case "$s" in
		@*) continue ;;
		esac
		[ "$(uci -q get "wireless.$s.mode")" = ap ] || continue
		[ "$(uci -q get "wireless.$s.device")" = "$r" ] || continue
		case " $GUEST_LIST " in
		*" $s "*) continue ;;
		esac
		cur=$(uci -q get "wireless.$s.disabled")
		if [ "$cur" = 1 ]; then
			continue
		fi
		[ -n "$cur" ] || cur=0
		uci -q set "wireless.$s.pasankalla_suspended=1"
		uci -q set "wireless.$s.pasankalla_orig_disabled=$cur"
		uci -q set "wireless.$s.disabled=1"
		WIRELESS_CHANGED=1
	done
}

resume_aps() {
	local keep="$1" s dev orig
	for s in $(uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
		case "$s" in
		@*) continue ;;
		esac
		[ "$(uci -q get "wireless.$s.pasankalla_suspended")" = 1 ] || continue
		dev=$(uci -q get "wireless.$s.device")
		if [ -n "$keep" ] && [ "$dev" = "$keep" ]; then
			continue
		fi
		orig=$(uci -q get "wireless.$s.pasankalla_orig_disabled")
		case "$orig" in
		0|1) ;;
		*) orig=0 ;;
		esac
		[ "$(uci -q get "wireless.$s.disabled")" = "$orig" ] || {
			uci -q set "wireless.$s.disabled=$orig"
			WIRELESS_CHANGED=1
		}
		uci -q delete "wireless.$s.pasankalla_suspended"
		uci -q delete "wireless.$s.pasankalla_orig_disabled"
		WIRELESS_CHANGED=1
	done
}

slider_on() {
	local v
	v=$(cat "$SLIDER_FILE" 2>/dev/null)
	if [ -z "$v" ]; then
		v=$(debugfs_slider)
	fi
	case "$v" in
	1)
		if [ "$SLIDER_INVERT" = 1 ]; then
			return 1
		fi
		return 0
		;;
	0)
		if [ "$SLIDER_INVERT" = 1 ]; then
			return 0
		fi
		return 1
		;;
	esac
	return 1
}

debugfs_slider() {
	local line
	line=$(grep -m1 'mode' /sys/kernel/debug/gpio 2>/dev/null)
	case "$line" in
	*"in  lo"*|*"in lo"*) echo 1 ;;
	*"in  hi"*|*"in hi"*) echo 0 ;;
	*) echo 0 ;;
	esac
}

# True while the system is still inside the post-boot WAN grace window.
# /proc/uptime is cheap; reading it costs less than starting a daemon.
boot_grace() {
	local up _
	[ "$WAN_GRACE" -gt 0 ] 2>/dev/null || return 1
	read -r up _ < /proc/uptime 2>/dev/null || return 1
	up=${up%%.*}
	is_num "$up" || return 1
	[ "$up" -lt "$WAN_GRACE" ]
}

offline_expired() {
	local now since
	now=$(date +%s)
	since=$(cat "$OFFLINE_FILE" 2>/dev/null)
	if ! is_num "$since"; then
		echo "$now" > "$OFFLINE_FILE"
		return 1
	fi
	[ $((now - since)) -ge "$OFFLINE_AFTER" ]
}

tm_running() {
	if [ ! -x /etc/init.d/travelmate ]; then
		return 1
	fi
	/etc/init.d/travelmate running >/dev/null 2>&1
}

# trm_wwan is probed by route/lookup for its default route, so a travelmate STA
# left on it would outbid the WAN route (metric 100) when both have a lease.
# Plugging and unplugging the network keeps the uplink option in travelmate
# untouched and never reloads the network (that would bounce the WAN).
tm_setif() {
	local ifc="$1" dev
	dev=$(uci -q get "wireless.$ifc.device")
	[ -n "$dev" ] || return 0
	case " $(uci -q get "wireless.$ifc.network") " in
	*" $TRM_IF "*) ;;
	*) return 1 ;;
	esac
	local list="" s
	for s in $(uci -q get "wireless.$ifc.network"); do
		if [ "$s" = "$TRM_IF" ]; then
			case "$2" in
			up) list="$list $s" ;;
			esac
			continue
		fi
		list="$list $s"
	done
	if [ "$(uci -q get "wireless.$ifc.network")" = "${list# }" ]; then
		return 1
	fi
	uci -q set "wireless.$ifc.network=${list# }"
	WIRELESS_CHANGED=1
	log "travelmate uplink \"$dev\" $2 ($TRM_IF)"
	return 0
}

# Who owns the uplink, as last applied: 1 = travelmate wanted, 0 = WAN.
# Reading the init's enabled flag is not a substitute: a running travelmate
# disables its own service once no uplink is left to scan, so "not enabled"
# would read back as "WAN owns it" on every poll.
tm_ledger() {
	case "$1" in
	get) cat "$TM_FILE" 2>/dev/null ;;
	set) echo "$2" > "$TM_FILE" 2>/dev/null ;;
	esac
}

# Plugging/unplugging every travelmate STA. With the network option gone
# the section is not initialized at all, so procd never bumps network.trm_wwan
# and a scheduled check of ours has no chance to outbid the ethernet WAN.
tm_stas() {
	uci -q show wireless 2>/dev/null |
		sed -n 's/^wireless\.\(trm_uplink[0-9]*\)=wifi-iface$/\1/p'
}

tm_stas_down() {
	local s
	for s in $(tm_stas); do
		tm_setif "$s" down
	done
}

# Stop travelmate. The init is left alone on purpose: procd only fires it on
# an interface event or a warm boot, and only rc.d decides that. The rc.d
# link is put back when it is gone, so the next boot starts travelmate even
# if a running instance removed its own link before the WAN lease arrived
# (the boot grace window keeps it stopped here, so nothing gets started).
tm_stop() {
	local was
	was=$(tm_ledger get)
	if [ "$was" = 0 ] && ! tm_running; then
		TM_DOWN=1
		if [ -x /etc/init.d/travelmate ] &&
		   ! /etc/init.d/travelmate enabled >/dev/null 2>&1; then
			log "travelmate enable"
			/etc/init.d/travelmate enable >/dev/null 2>&1
		fi
		tm_stas_down
		return 0
	fi
	if tm_running; then
		log "travelmate stop"
		/etc/init.d/travelmate stop >/dev/null 2>&1
	fi
	# Only the first transition of an apply is logged.
	[ "$TM_DOWN" = 1 ] || log "travelmate stop"
	TM_DOWN=1
	tm_ledger set 0
	tm_stas_down
	return 0
}

tm_start() {
	local was
	[ -x /etc/init.d/travelmate ] || return 0
	was=$(tm_ledger get)
	# travelmate is enabled by default and stays that way. A running
	# travelmate takes its own rc.d link out once nothing is left to scan,
	# so the link is only restored when we need it (it was quick to lose,
	# hence the explicit enable) and a running service is never restarted
	# just to refresh the link.
	if ! /etc/init.d/travelmate enabled >/dev/null 2>&1; then
		log "travelmate enable"
		/etc/init.d/travelmate enable >/dev/null 2>&1
	fi
	TM_DOWN=0
	tm_ledger set 1
	[ -n "$was" ] || was=0
	# A travelmate that keeps "running" with no lease is stuck (every
	# uplink candidate exhausted, or the saved profile is on another
	# band). Restarting makes wpa_supplicant scan again; rate-limited,
	# because each restart flaps its STA.
	stale=0
	if [ "$TM_RETRY" -gt 0 ] 2>/dev/null && tm_running && [ "$TRM_LEASE" != 1 ]; then
		now=$(date +%s)
		last=$(cat "$TM_RETRY_FILE" 2>/dev/null)
		if ! is_num "$last"; then
			echo "$now" > "$TM_RETRY_FILE" 2>/dev/null
		elif [ $((now - last)) -ge "$TM_RETRY" ]; then
			stale=1
		fi
	fi
	if [ "$was" != 1 ] && ! tm_running; then
		log "travelmate start radio=${TRM_RADIO:-none}"
		/etc/init.d/travelmate start >/dev/null 2>&1
		echo "$(date +%s)" > "$TM_RETRY_FILE" 2>/dev/null
	elif [ "$stale" = 1 ]; then
		log "travelmate restart radio=${TRM_RADIO:-none} (no lease yet)"
		/etc/init.d/travelmate restart >/dev/null 2>&1
		echo "$(date +%s)" > "$TM_RETRY_FILE" 2>/dev/null
	elif [ "$RADIO_CHANGED" = 1 ] && tm_running; then
		log "travelmate restart radio=${TRM_RADIO:-none}"
		/etc/init.d/travelmate restart >/dev/null 2>&1
		echo "$(date +%s)" > "$TM_RETRY_FILE" 2>/dev/null
	fi
	return 0
}

antilag_section() {
	local s
	for s in wan primary; do
		if [ "$(uci -q get "antilag.$s")" = antilag ]; then
			echo "$s"
			return 0
		fi
	done
	uci -q show antilag 2>/dev/null |
		sed -n 's/^antilag\.\([^.=]*\)=antilag$/\1/p' | head -n1
}

# Keep the antilag instance on the netdev that currently carries the uplink.
# The section starts as ul_if=wan, which does not exist; updating it here is
# also what follows a WAN DHCP device change or a switch to travelmate.
# With no uplink at all there is no traffic to shape and no reflector that
# can answer, so an antilag instance left attached to the dead device only
# logs stall/recovery churn and burns through its reflector list. Pause it
# while there is no uplink; the marker keeps the transition logged once.
antilag_set_state() {
	local want="$1" mark="$STATE_DIR/antilag_paused"

	[ -x /etc/init.d/antilag ] || return 0
	/etc/init.d/antilag enabled >/dev/null 2>&1 || return 0

	if [ "$want" = 0 ]; then
		# Stop it again if something brought it back (the iface hook, an
		# operator, a leftover procd instance): the marker only gates the
		# log line, not the state.
		if /etc/init.d/antilag running >/dev/null 2>&1; then
			/etc/init.d/antilag stop >/dev/null 2>&1
			if [ ! -f "$mark" ]; then
				: > "$mark"
				log "antilag paused: no uplink"
			fi
		fi
		return 0
	fi

	if [ ! -f "$mark" ]; then
		return 0
	fi
	rm -f "$mark"
	if ! /etc/init.d/antilag running >/dev/null 2>&1; then
		/etc/init.d/antilag start >/dev/null 2>&1
		log "antilag resumed: uplink back"
	fi
	return 0
}

antilag_update() {
	local sec dev old_ul old_dl new_dl

	[ -f /etc/config/antilag ] || return 0
	sec=$(antilag_section)
	[ -n "$sec" ] || return 0

	# Wired WAN down and travelmate without a lease: nothing to shape.
	if [ "$WAN" = 0 ] && [ "$TRM_LEASE" = 0 ]; then
		antilag_set_state 0
		return 0
	fi

	# The netdev the uplink really uses (l3_device first). A down wan
	# reports no l3_device at all, so the configured device is the
	# fallback - that is the case right after boot and right after an
	# unplug, when antilag must still follow the wired uplink.
	dev=""
	if [ "$WAN" = 1 ]; then
		dev=$(iface_l3dev "$WAN_IF")
	fi
	if [ -z "$dev" ] && [ "$TRM_LEASE" = 1 ]; then
		dev=$(iface_l3dev "$TRM_IF")
	fi
	if [ -z "$dev" ]; then
		dev=$(iface_l3dev "$WAN_IF")
	fi
	# Never point antilag at a netdev that is gone: it would fail its tc
	# setup and log on every restart. Keeping the last value is better.
	if [ -z "$dev" ] || [ ! -e "/sys/class/net/$dev" ]; then
		return 0
	fi

	antilag_set_state 1

	old_ul=$(uci -q get "antilag.$sec.ul_if")
	old_dl=$(uci -q get "antilag.$sec.dl_if")
	new_dl="ifb-$dev"
	if [ "$old_ul" = "$dev" ] && [ "$old_dl" = "$new_dl" ]; then
		return 0
	fi

	uci -q set "antilag.$sec.ul_if=$dev"
	uci -q set "antilag.$sec.dl_if=$new_dl"
	if ! uci -q commit antilag; then
		log "failed to commit antilag uplink $dev"
		return 1
	fi
	log "antilag $sec uplink ${old_ul:-none} -> $dev"
	# Only restart when antilag is actually running: restarting an instance
	# whose uplink netdev is missing (the link just died) only adds a failed
	# setup on top of the transition that is still settling.
	if [ -x /etc/init.d/antilag ] && /etc/init.d/antilag enabled >/dev/null 2>&1 &&
	   /etc/init.d/antilag running >/dev/null 2>&1; then
		/etc/init.d/antilag restart >/dev/null 2>&1
	fi
	return 0
}

# netifd can take minutes to set up the radios while the WAN profile is
# stuck (a DHCP-less wan renews forever), and /sbin/wifi waits for netifd.
# Running the reload inside the apply would hold the lock - and with it every
# button, iface and ieee80211 hook - for that whole time. Detached, the
# reload lands on whatever the next applies leave in the config.
wifi_reload() {
	log "wifi reload"
	/sbin/wifi reload >/dev/null 2>&1 &
}

# /sbin/wifi hands the work to netifd and returns; netifd then restarts every
# radio for another ten to twenty seconds on this CPU. Starting travelmate in
# that window is fatal: it associates, and the reload still in flight tears
# the fresh STA down (observed on the TR1200 - the failover looked connected
# and had no route for over a minute). Before travelmate starts, wait until
# no radio reports pending any more.
wifi_ready() {
	local i n p
	i=0
	n=0
	while [ "$i" -lt 45 ]; do
		p=$(ubus -t 3 call network.wireless status 2>/dev/null |
			jsonfilter -e '@.*.pending' 2>/dev/null | grep -c true)
		if [ "$p" = 0 ]; then
			n=$((n + 1))
			if [ "$n" -ge 2 ]; then
				return 0
			fi
		else
			n=0
		fi
		i=$((i + 1))
		sleep 1
	done
	return 1
}

# LED state left by the last apply. Rewriting trigger and brightness on
# every poll is pointless work (and a busy LED trigger keeps the CPU from
# idling); only the diff is written.
LED_APPLIED=""

led_set() {
	local base="/sys/class/leds/$1" cur
	[ -d "$base" ] || return 0
	cur=$(cat "$base/trigger" 2>/dev/null)
	case "$2" in
	on)
		case "$cur" in
		*"[none]"*) ;;
		*) echo none > "$base/trigger" 2>/dev/null ;;
		esac
		[ "$(cat "$base/brightness" 2>/dev/null)" = 1 ] || \
			echo 1 > "$base/brightness" 2>/dev/null
		;;
	off)
		case "$cur" in
		*"[none]"*) ;;
		*) echo none > "$base/trigger" 2>/dev/null ;;
		esac
		[ "$(cat "$base/brightness" 2>/dev/null)" = 0 ] || \
			echo 0 > "$base/brightness" 2>/dev/null
		;;
	timer)
		case "$cur" in
		*"[timer]"*) ;;
		*) echo timer > "$base/trigger" 2>/dev/null ;;
		esac
		[ "$(cat "$base/delay_on" 2>/dev/null)" = "$3" ] || \
			echo "$3" > "$base/delay_on" 2>/dev/null
		[ "$(cat "$base/delay_off" 2>/dev/null)" = "$3" ] || \
			echo "$3" > "$base/delay_off" 2>/dev/null
		;;
	esac
}

apply_leds() {
	if [ "$LED_APPLIED" = "$1" ]; then
		return 0
	fi
	LED_APPLIED="$1"
	case "$1" in
	wan)
		led_set "$LED_WHITE" on
		led_set "$LED_RED" off
		;;
	wifi)
		led_set "$LED_WHITE" timer 1000
		led_set "$LED_RED" off
		;;
	usb)
		led_set "$LED_WHITE" timer 250
		led_set "$LED_RED" off
		;;
	offline)
		led_set "$LED_WHITE" off
		led_set "$LED_RED" timer 1000
		;;
	*)
		led_set "$LED_WHITE" off
		led_set "$LED_RED" off
		;;
	esac
}

# Log only changes, not every poll: this runs on a weak CPU and syslog is
# already the primary debugging surface for the state machine.
detect_log() {
	local sig
	sig="$WAN|$WAN_WAIT|$USB_PRESENT|$USB_ACTIVE|$TRM_LEASE|$SLIDER|$TRM_RADIO|$WANT_TRM"
	if [ "$(cat "$DETECT_FILE" 2>/dev/null)" = "$sig" ]; then
		return 0
	fi
	log "detect wan=$WAN wan_wait=$WAN_WAIT usb_present=$USB_PRESENT usb_active=$USB_ACTIVE trm_lease=$TRM_LEASE slider=$SLIDER radio=${TRM_RADIO:-none} want_trm=$WANT_TRM"
	echo "$sig" > "$DETECT_FILE" 2>/dev/null
}

state_log() {
	local state="$1" sig prev
	prev=$(cut -d'|' -f1 "$SIG_FILE" 2>/dev/null)
	sig="$state|$WAN|$WAN_WAIT|$USB_PRESENT|$USB_ACTIVE|$TRM_LEASE|$SLIDER|$TRM_RADIO|$WANT_TRM"
	if [ "$(cat "$SIG_FILE" 2>/dev/null)" = "$sig" ]; then
		return 0
	fi
	log "state ${prev:-none} -> $state wan=$WAN wan_wait=$WAN_WAIT usb_present=$USB_PRESENT usb_active=$USB_ACTIVE trm_lease=$TRM_LEASE slider=$SLIDER radio=${TRM_RADIO:-none} want_trm=$WANT_TRM"
	echo "$sig" > "$SIG_FILE" 2>/dev/null
}

apply() {
	load_cfg
	mkdir -p "$STATE_DIR" 2>/dev/null
	# An apply killed mid-flight (procd SIGKILL, OOM) leaves its ubus reply
	# files behind; nothing else in /tmp matches this prefix.
	rm -f /tmp/pasankalla.status.* 2>/dev/null

	WIRELESS_CHANGED=0
	TRAVELMATE_CHANGED=0
	WAN=0
	USB_ACTIVE=0
	TRM_LEASE=0
	SLIDER=0
	TRM_RADIO=""
	GUEST_LIST=""
	TM_DOWN=0
	USB_PRESENT=0

	if [ "$ENABLED" != 1 ]; then
		tm_stop
		GUEST_LIST=$(guest_sections)
		for s in $GUEST_LIST; do
			[ "$(uci -q get "wireless.$s")" = wifi-iface ] || continue
			[ "$(uci -q get "wireless.$s.disabled")" = 1 ] || {
				uci -q set "wireless.$s.disabled=1"
				WIRELESS_CHANGED=1
			}
		done
		resume_aps ""
		if [ "$WIRELESS_CHANGED" = 1 ]; then
			uci -q commit wireless && wifi_reload
		fi
		if [ "$TRAVELMATE_CHANGED" = 1 ]; then
			uci -q commit travelmate
		fi
		apply_leds disabled
		rm -f "$OFFLINE_FILE"
		state_log disabled
		return 0
	fi

	USB_PATHS=$(usb_phy_paths)
	USB_PRESENT=0
	if [ -n "$USB_PATHS" ]; then
		USB_PRESENT=1
	fi
	# The port that was torn down for a dead link is alive again: bring the
	# interface back before the uplink is evaluated, so the wired WAN wins
	# over travelmate again as soon as the cable is in.
	if [ -f "$WAN_TORN_FILE" ] && ! wan_iface_up; then
		if wan_link_up "$(wan_dev)"; then
			log "wan link back: bringing the wan interface up"
			/sbin/ifup "$WAN_IF" >/dev/null 2>&1
			rm -f "$WAN_TORN_FILE"
		fi
	fi
	wan_ok && WAN=1
	trm_ok && TRM_LEASE=1
	if [ "$TRM_LEASE" = 1 ]; then
		rm -f "$TM_RETRY_FILE" 2>/dev/null
	fi

	USB_RADIO=""
	if [ "$USB_PRESENT" = 1 ]; then
		USB_RADIO=$(find_usb_radio)
	fi
	TRM_RADIO="$USB_RADIO"
	if [ -z "$TRM_RADIO" ]; then
		TRM_RADIO=$(find_builtin_5g)
	fi
	# A dead WAN link outranks whatever wan_ok saw: the debounced port check
	# is the only thing that notices an unplugged swconfig WAN, and it only
	# returns true on a later poll than the one that started the timer.
	WAN_LINK_DOWN=0
	if wan_link_down; then
		WAN_LINK_DOWN=1
		WAN=0
		# netifd still holds the address and the default route of the dead
		# port, and that route (metric 0) keeps outbidding travelmate. Release
		# them; the next apply brings the interface back once the port links.
		if wan_iface_up; then
			log "wan port down: releasing the stale lease"
			echo 1 > "$WAN_TORN_FILE" 2>/dev/null
			/sbin/ifdown "$WAN_IF" >/dev/null 2>&1
		fi
	fi

	# While the router just booted, give the ethernet WAN a chance to lease
	# before starting a 5 GHz scan. A hotplug iface event re-applies as soon
	# as the lease arrives, so this only delays the travelmate fallback.
	WAN_WAIT=0
	if [ "$WAN" = 0 ] && [ -n "$TRM_RADIO" ] && boot_grace; then
		WAN_WAIT=1
	fi
	# travelmate is needed whenever the WAN has no usable link. Whether a
	# travelmate radio exists only decides which one is used: without one
	# (no built-in 5 GHz, no stick) WANT_TRM=0, and the resolve below falls
	# back to plain offline - unless the last travelled profile is still
	# loaded, in which case travelmate keeps serving from it (the
	# "not configured" case that used to be logged forever).
	WANT_TRM=0
	if [ "$WAN" = 0 ] && [ "$WAN_WAIT" = 0 ]; then
		WANT_TRM=1
	fi
	# The USB radio is only "active" once it really carries the uplink, i.e.
	# travelmate is wanted and this poll selected it. Never fold that into
	# one && list: with WAN up the last test fails and the whole list turns
	# into a non-zero status.
	USB_ACTIVE=0
	if [ "$WANT_TRM" = 1 ] && [ -n "$USB_RADIO" ]; then
		USB_ACTIVE=1
	fi
	SLIDER=0
	if slider_on; then
		SLIDER=1
	fi
	GUEST_LIST=$(guest_sections)

	detect_log
	antilag_update

	# Read the radio travelmate owns BEFORE anything writes it, and only
	# write it while travelmate is wanted (the call sits in the WANT_TRM
	# branch below). Calling set_trm_radio unconditionally here also plugged
	# the STA into trm_wwan on every WAN-up poll, which tm_stop then unplugged
	# again: a wireless change and a wifi reload every single poll.
	OLD_TRM_RADIO=$(uci -q get travelmate.global.trm_radio)
	RADIO_CHANGED=0
	# Only compare/announce the travelmate radio while travelmate is wanted.
	# With WAN up TRM_RADIO is just a hint and is never written below, so
	# comparing it every poll logged the same transition forever.
	if [ "$WANT_TRM" = 1 ] && [ -n "$TRM_RADIO" ] &&
	   [ "$OLD_TRM_RADIO" != "$TRM_RADIO" ]; then
		RADIO_CHANGED=1
		log "radio ${OLD_TRM_RADIO:-none} -> $TRM_RADIO"
	fi
	# Without any radio section there is nothing to travel on. Keep
	# travelmate running if it already owns the uplink (a loaded profile
	# with a connected STA); otherwise a WAN-less router is just offline.
	if [ "$WANT_TRM" = 1 ] && [ -z "$TRM_RADIO" ]; then
		trm_ok || WANT_TRM=0
	fi
	# A radio switch (USB plugged/unplugged) gets a fresh grace period, so
	# the LED shows the new fast/slow blink before falling back to red.
	if [ "$WANT_TRM" = 1 ] && [ "$RADIO_CHANGED" = 1 ]; then
		rm -f "$OFFLINE_FILE"
	fi

	# WAN wins: stop travelmate and unplug its STA before touching wifi so a
	# reload cannot bring an uplink back. Travelmate itself stays enabled
	# (it is enabled by default) so the switch back needs no boot cycle.
	# A radio switch restarts a running travelmate (see tm_start) instead of
	# stopping it first: restarting rescans immediately and keeps the ledger
	# on the travelmate side.
	TM_DOWN=0
	if [ "$WANT_TRM" = 0 ]; then
		tm_stop
	fi

	# Only bring the selected travelmate radio up while travelmate is
	# actually needed. With WAN up the radio is left alone (the guest loop
	# below still enables whatever radio an active guest BSS needs), so a
	# USB stick plugged into a WAN-connected router does not cost a reload.
	if [ "$WANT_TRM" = 1 ] && [ -n "$TRM_RADIO" ]; then
		set_radio_disabled "$TRM_RADIO" 0
		set_trm_radio "$TRM_RADIO"
		for s in $(tm_stas); do
			[ "$(uci -q get "wireless.$s.device")" = "$TRM_RADIO" ] &&
				tm_setif "$s" up
		done
	fi
	# A stale USB radio section (unplugged, or another USB port) must not be
	# brought up by wifi reload.
	for r in $(radio_list); do
		rp=$(uci -q get "wireless.$r.path")
		case "$rp" in
		*usb*) ;;
		*) continue ;;
		esac
		# A test that ends a && list can be the last command of this
		# loop body, and one false case would then end apply early.
		if [ "$WANT_TRM" = 1 ] && [ "$r" = "$TRM_RADIO" ]; then
			continue
		fi
		set_radio_disabled "$r" 1
	done

	# Keep the private APs off the radio travelmate is scanning on. Guest
	# BSSes are handled by the follow-uplink rule below, so they are not
	# touched here.
	if [ "$WANT_TRM" = 1 ] && [ -n "$TRM_RADIO" ]; then
		resume_aps "$TRM_RADIO"
		suspend_aps "$TRM_RADIO"
	else
		resume_aps ""
	fi

	for s in $GUEST_LIST; do
		[ "$(uci -q get "wireless.$s")" = wifi-iface ] || continue
		desired=1
		if [ "$SLIDER" = 1 ]; then
			desired=0
		fi
		if [ "$desired" = 0 ] && [ "$GUEST_5G_FOLLOW" = 1 ] &&
		   [ "$WANT_TRM" = 1 ] && [ -n "$TRM_RADIO" ]; then
			dev=$(uci -q get "wireless.$s.device")
			if [ "$dev" = "$TRM_RADIO" ] && [ "$(radio_band "$dev")" = 5g ]; then
				desired=1
			fi
		fi
		dev=$(uci -q get "wireless.$s.device")
		if [ "$desired" = 0 ] && [ -n "$dev" ]; then
			set_radio_disabled "$dev" 0
		fi
		if [ "$(uci -q get "wireless.$s.disabled")" = "$desired" ]; then
			continue
		fi
		log "guest $s disabled=$desired"
		uci -q set "wireless.$s.disabled=$desired"
		WIRELESS_CHANGED=1
	done

	if [ "$WIRELESS_CHANGED" = 1 ]; then
		if uci -q commit wireless; then
			wifi_reload
			if [ "$WANT_TRM" = 1 ]; then
				wifi_ready || log "wifi still settling after 45s"
			fi
		else
			log "failed to commit wireless"
			return 1
		fi
	fi
	if [ "$TRAVELMATE_CHANGED" = 1 ]; then
		uci -q commit travelmate || log "failed to commit travelmate"
	fi

	if [ "$WANT_TRM" = 1 ]; then
		tm_start
	fi

	if [ "$WAN" = 1 ]; then
		state=wan
		rm -f "$OFFLINE_FILE"
	elif [ "$TRM_LEASE" = 1 ] && [ "$WANT_TRM" = 1 ]; then
		# A travelmate lease is the verdict on where the uplink is, not
		# the age of the office: a working Wi-Fi uplink must never fade
		# into "offline" because the WAN drop has been offline_after long.
		state=wifi
		if [ "$USB_ACTIVE" = 1 ]; then
			state=usb
		fi
		rm -f "$OFFLINE_FILE"
	elif [ "$WAN_WAIT" = 1 ]; then
		# WAN may still lease; show the travelmate "searching" blink rather
		# than claiming the router is offline.
		state=wifi
		rm -f "$OFFLINE_FILE"
	elif [ "$WANT_TRM" = 0 ]; then
		state=offline
		rm -f "$OFFLINE_FILE"
	else
		# Travelmate is up and looking for Wi-Fi, with no lease yet:
		# the fallback LED is honest about it, so red is only for a
		# router that has really been without any uplink.
		if offline_expired; then
			state=offline
		else
			state=wifi
			if [ "$USB_ACTIVE" = 1 ]; then
				state=usb
			fi
		fi
	fi

	sync_wan_zone
	apply_leds "$state"
	state_log "$state"
	return 0
}

apply_locked() {
	# Never wait for an apply that is already running: the next poll is
	# seconds away and every hotplug fires its own. Overlapping applies
	# were what left the configs half-written. A hotplug that finds the
	# lock taken leaves the marker behind, so the poll that holds it runs
	# apply again right after and the burst of events (a WAN drop raises
	# iface, ieee80211 and button hookups at once) becomes one apply.
	if run_lock; then
		rm -f "$PENDING_FILE" 2>/dev/null
		trap 'run_unlock' EXIT INT TERM HUP
		while :; do
			apply
			if [ ! -f "$PENDING_FILE" ]; then
				break
			fi
			rm -f "$PENDING_FILE" 2>/dev/null
		done
		run_unlock
		trap - EXIT INT TERM HUP
	else
		: > "$PENDING_FILE" 2>/dev/null
	fi
	# A hotplug event or the poll must never take the daemon down with
	# procd, which restarts a service whose script fails.
	return 0
}

daemon() {
	local t start
	while :; do
		# Re-read the config every poll: pasankalla reload expects it.
		load_cfg
		start=$(date +%s)
		apply_locked
		# Sleep until the next tick rather than for a fixed interval: a slow
		# apply (a DHCP-less wan makes netifd answer slowly) is not followed
		# by a full extra sleep, which would double the detection latency.
		t=$(date +%s)
		t=$((start + POLL_INTERVAL - t))
		if [ "$t" -lt 1 ]; then
			t=1
		fi
		sleep "$t"
	done
}

status() {
	load_cfg
	mkdir -p "$STATE_DIR" 2>/dev/null
	USB_PATHS=$(usb_phy_paths)
	USB_PRESENT=0
	if [ -n "$USB_PATHS" ]; then
		USB_PRESENT=1
	fi
	WAN=0
	wan_ok && WAN=1
	TRM_LEASE=0
	trm_ok && TRM_LEASE=1
	USB_RADIO=""
	if [ "$USB_PRESENT" = 1 ]; then
		USB_RADIO=$(find_usb_radio)
	fi
	TRM_RADIO="$USB_RADIO"
	if [ -z "$TRM_RADIO" ]; then
		TRM_RADIO=$(find_builtin_5g)
	fi
	WAN_LINK_DOWN=0
	if wan_link_down; then
		WAN_LINK_DOWN=1
		WAN=0
	fi
	WAN_WAIT=0
	if [ "$WAN" = 0 ] && [ -n "$TRM_RADIO" ] && boot_grace; then
		WAN_WAIT=1
	fi
	SLIDER=0
	if slider_on; then
		SLIDER=1
	fi
	echo "enabled=$ENABLED"
	echo "guest_network=$GUEST_NET device=$(uci -q get "network.$GUEST_NET.device")"
	echo "trm_iface=$TRM_IF device=[$(uci -q get "network.$TRM_IF.device")]"
	echo "wan_link_down=$WAN_LINK_DOWN"
	echo "slider=$SLIDER"
	echo "wan=$WAN"
	echo "wan_wait=$WAN_WAIT"
	echo "usb_present=$USB_PRESENT"
	USB_ACTIVE=0
	if [ "$WAN" = 0 ] && [ "$WAN_WAIT" = 0 ] && [ -n "$USB_RADIO" ] && [ "$USB_RADIO" = "$TRM_RADIO" ]; then
		USB_ACTIVE=1
	fi
	echo "usb_active=$USB_ACTIVE"
	echo "trm_lease=$TRM_LEASE"
	echo "trm_radio=${TRM_RADIO:-none}"
	echo "travelmate_running=$(tm_running && echo 1 || echo 0)"
	echo "guest_sections=$(guest_sections | tr '\n' ' ')"
	echo "state=$(cat "$SIG_FILE" 2>/dev/null | cut -d'|' -f1)"
}

# Sourcing this file (tests, debugging) must not run the entry point.
if [ -n "${PASANKALLA_SOURCED:-}" ]; then
	return 0
fi

mkdir -p "$STATE_DIR" 2>/dev/null

case "$1" in
daemon)
	# One daemon only: two pollers walked over each other in testing and
	# the survivors multiplied on the writable overlay. The pid file is
	# written with set -C (never truncated, only replaced after the stale
	# one was removed), so the second instance reliably lands here.
	for n in 1 2 3; do
		prev=$(cat "$DAEMON_PID" 2>/dev/null)
		if [ -n "$prev" ] && kill -0 "$prev" 2>/dev/null &&
		   is_pasankalla_pid "$prev"; then
			log "daemon already running (pid $prev)"
			exit 0
		fi
		rm -f "$DAEMON_PID" 2>/dev/null
		if (set -C; echo "$$" > "$DAEMON_PID") 2>/dev/null; then
			trap 'rm -f "$DAEMON_PID"' EXIT INT TERM HUP
			break
		fi
	done
	;;
esac
case "$1" in
apply)
	apply_locked
	;;
daemon)
	daemon
	;;
status)
	status
	;;
""|reload)
	# procd reload_service runs the init reload script, which execs this.
	apply_locked
	;;
*)
	echo "usage: $0 {apply|daemon|status}" >&2
	exit 1
	;;
esac
