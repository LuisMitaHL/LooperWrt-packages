config config 'config'
	# Watchdog master switch
	option enabled '1'

	# Seconds between checks
	option interval '30'

	# Verbose per-cycle diagnostics (desired vs actual routes, rule
	# checks, heal decisions) into syslog. Off by default.
	option debug '0'

	# Tailscale routing table and policy rule base (default install
	# is table 52, rule priorities 5210/5230/5250/5270). Only change
	# if tailscaled stops using its 5200 base - with mwan3 priority
	# bases at 1100/1200 (dl12345/mwan3-tailscale-setup) it always will.
	option table '52'
	option rule_base '5200'
	option iface 'tailscale0'
