# zz-ap-network-defaults -- dumb-AP network layout for every `ap` profile
# image (aurora, mt7621, ipq40xx cAP ac, mt76x8). Sourced once by
# uci_apply_defaults (init.d/boot) and removed on success; the
# looperwrt.ap_netdefaults marker in /etc/config/looperwrt (preserved by a
# settings-kept sysupgrade) stops later flashes from re-applying it. Named
# zz-* so it runs AFTER the branch's per-target 99_*-defaults -- those set
# antilag primary.enabled='1' and ul_if='wan', which must not win over this.
#
# Result on a fresh install:
#   * every physical port is a br-lan port, the wan interface is gone
#   * lan is a DHCP client (its address comes from the network's router)
#   * DHCPv4, DHCPv6 and RA servers are off where the server packages are
#     installed. ap_lite does not install dnsmasq/odhcpd at all, so there is
#     no /etc/config/dhcp and this block is a no-op there.
#   * antilag is disabled (if installed): there is no L3 uplink left to shape
#
# SAFETY (2026-10-26): the conversion is destructive -- it deletes every
# non-lan interface and its device section. It therefore only runs when the
# network config still has the stock shape generated by /bin/config_generate
# (stock lan, plus at most the board's wan, and nothing else). Any other
# config -- an upgraded device with hand-made management interfaces, VLANs,
# extra bridges -- is left untouched and marked 'skipped', so a settings-kept
# sysupgrade can never wipe an operator's network config again.
# /dev/kmsg is used instead of logger: this runs before syslogd starts.

die() {
	echo "ap-netdefaults: $*" > /dev/kmsg 2>/dev/null
	exit 1
}
note() {
	echo "ap-netdefaults: $*" > /dev/kmsg 2>/dev/null
}

# Write the marker and commit. $1 is '1' (converted), 'skipped' (foreign
# config) or 'already' (a pre-existing marker under an anonymous section).
# Returns non-zero when the marker cannot be persisted: the caller must then
# leave the script in place (exit 1) so it is retried, never "applied".
mark() {
	touch /etc/config/looperwrt 2>/dev/null || return 1
	uci -q set looperwrt.ap_netdefaults=defaults || return 1
	uci -q set "looperwrt.ap_netdefaults.applied=$1" || return 1
	uci -q commit looperwrt || return 1
	[ "$(uci -q get looperwrt.ap_netdefaults.applied)" = "$1" ] || return 1
	return 0
}

# --- 0. already applied? ----------------------------------------------------
if uci -q get looperwrt.ap_netdefaults.applied >/dev/null; then
	exit 0
fi

# A marker under an anonymous 'config defaults' section (the old docs told
# operators to hand-write one) means "the operator already handled this":
# adopt it instead of converting, and keep the marker readable.
if [ -z "$(uci -q get looperwrt.ap_netdefaults)" ]; then
	for s in $(uci -q show looperwrt | sed -n 's/^looperwrt\.\([^.=]*\)=defaults$/\1/p'); do
		[ "$(uci -q get "looperwrt.$s.applied")" = "1" ] || continue
		mark already || die "cannot adopt the anonymous marker (looperwrt.$s)"
		note "adopted anonymous marker in looperwrt.$s; network left untouched"
		exit 0
	done
fi

# preinit did not run / config not generated yet: keep the script for the
# next boot instead of marking it applied.
[ -f /etc/config/network ] || exit 1

# An unparseable config is not something to act on: keep the script and
# retry next boot (uci -q hides the parser error, so probe without it).
uci show network >/dev/null 2>&1 || die "network config is unparseable (rc=$?); refusing to convert, retrying next boot"

# Print the uci section id (named or @type[N]) of the `config device` section
# whose option name is $1. Re-run right before every delete so anonymous
# @device[N] indices are resolved against the current list, never stale.
devsec() {
	uci -q show network | sed -n "s/^network\.\([^.=]*\)\.name='$1'\$/\1/p" | head -n1
}

# --- 1. is this still the stock layout? -------------------------------------
# Stock means: the generated 'loopback', 'lan' and (on boards that define one)
# 'wan'/'wan6'; no other interface sections. Anything else is the operator's,
# and is never touched.
wan_present=0
for s in $(uci -q show network | sed -n 's/^network\.\([^.=]*\)=interface$/\1/p'); do
	case "$s" in
		loopback) ;;
		lan) ;;
		wan|wan6) wan_present=1 ;;
		*)
			note "network.$s is not stock: keeping the existing config as is"
			mark skipped || die "cannot persist the skipped marker; leaving the script for the next boot"
			note "marked skipped; run 'uci set looperwrt.ap_netdefaults.applied=1; uci commit looperwrt' to force it"
			exit 0
			;;
	esac
done
[ "$wan_present" = "1" ] || note "no wan interface: treating this as a stock one-port layout"

# --- 2. collect the port(s) of every non-lan interface into br-lan ---------
# Only 'wan' can reach this loop now (checked in step 1).
absorb=""      # netdevs to enslave into br-lan
dropdevs=""    # device-section netdev names to delete (re-resolved later)
dropifs=""     # interface sections to delete
for s in wan wan6; do
	uci -q get "network.$s" >/dev/null || continue
	[ "$(uci -q get "network.$s.proto")" = "none" ] && continue   # tailscale/mesh
	dev=$(uci -q get "network.$s.device")
	[ -z "$dev" ] && dev=$(uci -q get "network.$s.ifname")
	[ -n "$dev" ] || continue
	case "$dev" in
		lo|tailscale0) continue ;;
	esac
	# ifname may be a space-separated port list or contain a '.'/'@' uci
	# switch syntax; skip the section rather than guess.
	case "$dev" in
		*.*|*@*) continue ;;
	esac
	dsec=$(devsec "$dev")
	if [ -n "$dsec" ] && [ "$(uci -q get "network.$dsec.type")" = "bridge" ]; then
		# the interface is a bridge (e.g. a hand-made br-wan): enslave its
		# member ports, not the bridge itself, then drop the bridge device
		for p in $(uci -q get "network.$dsec.ports"); do absorb="$absorb $p"; done
		dropdevs="$dropdevs $dev"
	else
		absorb="$absorb $dev"
		[ -n "$dsec" ] && dropdevs="$dropdevs $dev"
	fi
	dropifs="$dropifs $s"
done

# --- 3. br-lan must exist and hold every physical port ---------------------
lan_dev=$(uci -q get network.lan.device)
if [ -n "$lan_dev" ] && [ "$lan_dev" != "br-lan" ]; then
	# lan sits on a plain netdev: enslave it too, then point lan at the bridge
	absorb="$absorb $lan_dev"
	uci -q set network.lan.device='br-lan'
	[ -n "$(devsec "$lan_dev")" ] && dropdevs="$dropdevs $lan_dev"
fi
lsec=$(devsec "br-lan")
if [ -z "$lsec" ]; then
	uci -q batch <<-EOF
		set network.lan.device='br-lan'
		add network device
		set network.@device[-1].name='br-lan'
		set network.@device[-1].type='bridge'
	EOF
	lsec=$(devsec "br-lan")
fi
ports=" $(uci -q get "network.$lsec.ports") "
for p in $absorb; do
	case "$ports" in
		*" $p "*) ;;
		*)
			uci -q add_list "network.$lsec.ports=$p"
			ports="$ports$p "
			;;
	esac
done

# --- 4. remove the absorbed interfaces and their device sections -----------
for d in $dropdevs; do
	s=$(devsec "$d")
	[ -n "$s" ] && uci -q delete "network.$s"
done
for s in $dropifs; do
	uci -q delete "network.$s"
done

# --- 5. lan becomes a DHCP client -------------------------------------------
uci -q set network.lan.proto='dhcp'
uci -q delete network.lan.ipaddr
uci -q delete network.lan.netmask
uci -q delete network.lan.ip6assign

# --- 6. drop dhcp sections whose interface no longer exists (wan6 etc.) ----
# Anonymous @dhcp[N] ids shift when one is deleted, so rescan after every
# successful delete instead of trusting a list captured up front.
while :; do
	kill=""
	for s in $(uci -q show dhcp | sed -n 's/^dhcp\.\([^.=]*\)=dhcp$/\1/p'); do
		ifname=$(uci -q get "dhcp.$s.interface")
		if [ -n "$ifname" ] && ! uci -q get "network.$ifname" >/dev/null 2>&1; then
			uci -q delete "dhcp.$s"
			kill=1
			break
		fi
	done
	[ -z "$kill" ] && break
done

# --- 7. DHCPv4, DHCPv6 and RA servers fully off (when installed) ----------
# ignore=1 stops dnsmasq's DHCPv4; odhcpd parses ra/dhcpv6/ndp/dhcpv4 as
# "disabled" (parse_mode in its config.c) and keeps iface->ignore=true when
# no mode is != disabled. The section stays so LuCI can re-enable it. On
# ap_lite there is no /etc/config/dhcp: the loop is empty and the commit is
# skipped below.
for s in $(uci -q show dhcp | sed -n 's/^dhcp\.\([^.=]*\)=dhcp$/\1/p'); do
	uci -q set "dhcp.$s.ignore=1"
	uci -q set "dhcp.$s.ra=disabled"
	uci -q set "dhcp.$s.dhcpv6=disabled"
	uci -q set "dhcp.$s.ndp=disabled"
	uci -q set "dhcp.$s.dhcpv4=disabled"
done
# ap_lite ships no DHCP/DNS server packages, so /etc/config/dhcp may not
# exist; do not create an empty config just to commit it.
[ -f /etc/config/dhcp ] && uci -q commit dhcp

# --- 8. antilag has no L3 uplink to shape on a dumb AP ----------------------
if [ -f /etc/config/antilag ]; then
	uci -q set antilag.primary.enabled='0'
	uci -q commit antilag
fi

# --- 9. commit + mark as applied (marker survives a settings-kept upgrade) --
uci -q commit network
mark 1 || die "cannot persist the applied marker; network left unmarked (script retries next boot)"

exit 0
