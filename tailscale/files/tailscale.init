#!/bin/sh /etc/rc.common

# Copyright 2020 Google LLC.
# Copyright (C) 2021 CZ.NIC z.s.p.o. (https://www.nic.cz/)
# SPDX-License-Identifier: Apache-2.0

USE_PROCD=1
START=80

export TS_NO_LOGS_NO_SUPPORT=true

start_service() {
  local state_file
  local port
  local std_err std_out

  config_load tailscale
  config_get_bool std_out "settings" log_stdout 1
  config_get_bool std_err "settings" log_stderr 1
  config_get port "settings" port 41641
  config_get state_file "settings" state_file /etc/tailscale/tailscaled.state
  config_get fw_mode "settings" fw_mode nftables
  config_get gomemlimit "settings" gomemlimit 90MiB
  config_get netmap_cache "settings" netmap_cache ram

  # Netmap cache placement. tailscaled v1.104 has no cache-dir flag of its
  # own: it derives the cache from the state file's directory (varRoot
  # /etc/tailscale -> profile-data/<profileID>/netmap-cache, see
  # ipn/ipnlocal/diskcache.go). 'ram' symlinks that directory onto tmpfs so
  # the per-peer / per-netmap rewrites never touch the flash overlay -- the
  # cache is disposable and only needs to outlive a tailscaled respawn, not a
  # reboot. 'off' keeps the tmpfs symlink (the home-DERP write path is NOT
  # gated by the env knob in 1.104.1) and disables the cache in tailscaled.
  # 'flash' leaves upstream behaviour, for anyone who wants to survive a
  # reboot with the control plane unreachable.
  #
  # The tmpfs target must exist BEFORE tailscaled runs: os.MkdirAll on a
  # dangling symlink fails with EEXIST, which would silently leave the cache
  # off. The [ ! -L ] guard keeps /etc writes to the first boot only.
  case "$netmap_cache" in
    flash)
      [ -L /etc/tailscale/profile-data ] && rm -f /etc/tailscale/profile-data
      ;;
    *)
      mkdir -p /etc/tailscale /tmp/tailscale-profile-data
      if [ ! -L /etc/tailscale/profile-data ]; then
        rm -rf /etc/tailscale/profile-data   # disposable cache (flash -> ram)
        ln -sfn /tmp/tailscale-profile-data /etc/tailscale/profile-data
      fi
      ;;
  esac

  /usr/sbin/tailscaled --cleanup

  procd_open_instance
  procd_set_param command /usr/sbin/tailscaled

  # Starting with v1.48.1 ENV variable is required to enable use of iptables / nftables.
  # Use nftables by default - can be changed to 'iptables' in tailscale config
  procd_set_param env TS_DEBUG_FIREWALL_MODE="$fw_mode"

  # Disable logging to log.tailscale.com
  procd_append_param env TS_NO_LOGS_NO_SUPPORT=true

  # Constrain the Go runtime on memory-tight devices: collect more eagerly
  # (GOGC=20) and keep the heap under a soft GOMEMLIMIT ceiling. The
  # ceiling comes from uci tailscale.settings.gomemlimit, defaulting to
  # 90MiB; RAM-tight profiles pin 40MiB via the tailscale-lowmem package
  # (selected by the builder's configs/core_lite.config), whose
  # uci-defaults is the single source of that value.
  procd_append_param env GOGC=20
  procd_append_param env GOMEMLIMIT="$gomemlimit"

  # Netmap caching opt-out (uci tailscale.settings.netmap_cache='off').
  # TS_USE_CACHED_NETMAP is a hidden envknob defaulting to true; 'false'
  # makes tailscaled discard the cache and skip both the write and the load
  # path. Note the tailnet's 'disable-cache-network-maps' node attribute is
  # NOT honoured by 1.104.1, so this is the only local switch there is.
  [ "$netmap_cache" = off ] && procd_append_param env TS_USE_CACHED_NETMAP=false

  # Set the port to listen on for incoming VPN packets.
  # Remote nodes will automatically be informed about the new port number,
  # but you might want to configure this in order to set external firewall
  # settings.
  procd_append_param command --port "$port"
  procd_append_param command --state "$state_file"

  procd_set_param respawn
  procd_set_param stdout "$std_out"
  procd_set_param stderr "$std_err"

  procd_close_instance
}

stop_service() {
  /usr/sbin/tailscaled --cleanup
}
